# talos.pipeline.yml
# Per-project configuration for Talos.
# Copy to your repo root as talos.pipeline.yml and edit for your project.
#
# Config file lookup order used by pipeline scripts:
#   1. $PIPELINE_CONFIG env var (absolute path)
#   2. ./talos.pipeline.yml  (recommended name)
#   3. ./pipeline.yaml

# Optional: GitHub owner/repo. Auto-detected from `git remote get-url origin` if omitted.
# repo: myorg/myrepo

# The branch all PRs target (integration branch). Developer subagents branch off this.
# Never assume "main" — many repos use "dev", "develop", or "trunk".
base_branch: dev

# ── VCS provider ─────────────────────────────────────────────────────────────
# Selects which version-control backend pipeline-vcs.sh targets.
# Options: github | gitlab | azure | file
#
#   github  — Uses the `gh` CLI. Battle-tested. Requires `gh auth login`.
#   gitlab  — Uses the `glab` CLI. Best-effort; PR approval flow differs.
#             Requires `glab auth login`.
#   azure   — Uses the `az` CLI + azure-devops extension.
#             Requires `az login` and `az extension add --name azure-devops`.
#             Labels map to ADO Tags; diff-pr is not supported.
#   file    — No VCS. Work items are `- [ ] Task <!-- id: N -->` checkboxes in
#             a local markdown file. Developer commits to a branch; QA/reviewer/
#             security/docs stages are skipped. Useful for local sessions or when
#             there is no remote repo yet (chat mode bootstraps this automatically).
#
# Which providers are production-ready:
#   github ✓  (used in CI, thoroughly tested)
#   gitlab ~  (implemented, best-effort — glab quirks may surface)
#   azure  ~  (implemented, best-effort — az CLI version sensitivity)
#   file   ✓  (used for chat mode and local sessions)
vcs:
  provider: github             # github | gitlab | azure | file

  # repo: myorg/myrepo         # override auto-detect; required for azure if
                                # `git remote get-url origin` is unavailable

  # token_env: "MY_BOT_TOKEN"  # vcs.token_env: name of the env var holding
                                # the GitHub token for the github-api provider
                                # (token-only, no gh CLI). Default: unset,
                                # falls back to GITHUB_TOKEN then GH_TOKEN.
                                # No effect on the github provider (uses gh auth).

  # ── Azure DevOps only ────────────────────────────────────────────────────
  # azure:
  #   org_url: https://dev.azure.com/myorg
  #   project: MyProject
  #   # create-issue makes work items of this type, in this area path, so
  #   # pipeline-created items land on the right team board. Type is
  #   # process-specific (Scrum → "Product Backlog Item"; Agile → "User Story").
  #   work_item_type: "Product Backlog Item"
  #   area_path: "MyProject\\My Team"     # omit to use the project root area
  #
  # NOTE (Azure): if `main` has branch policies (min reviewers / build
  # validation), no agent can auto-merge — set merge.auto: false below.
  # find-pr / check-pr-files / rerun-ci are not implemented for ADO.

  # ── File mode only ───────────────────────────────────────────────────────
  # file:
  #   source:
  #     path: plan.md           # path to your markdown checklist (default: plan.md)
  #                             # Items must be `- [ ] Title` (unchecked = open work)

# Production / release branch (used for release notes and CHANGELOG headers).
release_branch: main

# ── Board ─────────────────────────────────────────────────────────────────────
# Set enabled: false to skip board updates entirely (label-only mode).
board:
  enabled: true

  # ── GitHub Projects (provider: github) ────────────────────────────────────
  project_number: 1            # Run `gh project list --owner OWNER` to find yours
  owner: myorg                 # GitHub org or user that owns the project board
  status_field: Status         # Exact name of the single-select status field
  statuses:
    # Display names must match exactly what appears in the GitHub Project UI.
    ready: "Ready"
    in_progress: "In progress"
    in_review: "In review"
    done: "Done"
    blocked: "Blocked"

  # status_map:                 # board.status_map: optional flat mapping from
  #   Blocked: "Needs attention" # pipeline status names to your board's actual
                                  # column names, when they differ from the
                                  # "statuses" display names above. An absent
                                  # key passes through unchanged. Default: unset.

  # ── Azure DevOps (provider: azure) ────────────────────────────────────────
  # ADO has no separate status field — a work item's State drives its Kanban
  # column. Map the pipeline's status names to ADO states (process-specific;
  # Scrum defaults shown). Leave a value empty to keep the state unchanged.
  # azure_states:
  #   ready: "New"
  #   in_progress: "Committed"
  #   in_review: "Committed"
  #   done: "Done"
  #   blocked: ""              # Scrum has no Blocked state

# ── Verify commands ───────────────────────────────────────────────────────────
# Every code subagent must pass ALL of these before opening a PR.
# Use your repo's actual test, lint, and typecheck commands.
verify:
  - python -m pytest tests/ -x -q
  # - npm test
  # - make lint
  # - bash tests/run-tests.sh --quiet   # if using Talos's own bash test suite
  # - npx tsc --noEmit
  # - cargo test

# verify.qa_mode (ci | local): when ci -- the default whenever
#   merge.required_checks below is non-empty -- QA trusts CI (pr-checks)
#   instead of re-running verify: locally. When local -- the default when
#   merge.required_checks is empty/absent -- QA runs the full verify: list
#   above once itself, as before. Set this explicitly to override the
#   required_checks-derived default.
# verify.targeted (default true): while iterating, the developer runs only
#   the tests covering the files it changed, then the full verify: list
#   above exactly once before its final commit. Set false to make it run
#   the full list on every iteration instead.
# verify.ci_wait_s (default 900): seconds QA waits in the foreground, under
#   qa_mode: ci, for merge.required_checks to go green before failing closed
#   (via pr-checks-required, scoped to just those checks). Must be a positive
#   integer.
# verify.timeout_ms (default 600000): milliseconds substituted into the
#   foreground rule placed next to every verify and CI-wait instruction in
#   the developer/QA prompts -- the explicit timeout a stage passes to its
#   verify command instead of backgrounding it. Must be a positive integer.

# ── Merge settings ────────────────────────────────────────────────────────────
merge:
  auto: true                   # true  = orchestrator merges once all gates pass
                               # false = human-merge mode: run every stage and gate
                               #         (approvals, forbidden files, CI), then label
                               #         the PR pipeline:approved, comment "ready for
                               #         human merge", and stop. Use for integration
                               #         branches whose protection requires a human
                               #         review the pipeline can't self-provide.
  method: squash               # squash | merge | rebase
  required_checks:             # CI check names that must be green before merging
    - test                     # Must match the check name in GitHub Actions / CI
  delete_branch: true          # Delete feature branch after a successful merge
  # forbidden_files:           # PR paths matching these glob patterns block the
  #   - ".env"                 # merge for human review (defaults shown; basename
  #   - ".env.*"               # and full path are both matched)
  #   - "*.pem"
  #   - "*.key"
  #   - "*.p12"
  #   - "*.pfx"
  #   - "*.secrets"
  #   - "secrets.*"
  # forbidden_files_replace: false  # merge.forbidden_files_replace: set true to
                                     # restore pre-v0.13 behaviour -- forbidden_files
                                     # REPLACES the built-in defaults above instead
                                     # of unioning with them. Security warning:
                                     # suppresses built-in secret-protection
                                     # patterns for every PR. Default: false.
  # forbidden_files_allow:      # merge.forbidden_files_allow: explicit exemptions
  #   - ".env.example"           # checked before deny patterns (e.g. allow a
                                  # committed template while keeping the real
                                  # file blocked). Default: [] (empty).
  # union_paths:                # Paths a CONFLICTING PR's conflicts must be
  #   - "CHANGELOG.md"           # fully covered by (default shown) for
                                 # pipeline-mergebase.sh to resolve them
                                 # mechanically -- both sides kept via
                                 # `git merge-file --union`, no developer
                                 # dispatch (#256). Any other conflicting
                                 # path falls back to the developer
                                 # merge-base task as before.

# ── Issue selection ───────────────────────────────────────────────────────────
issues:
  label_filter: "pipeline:ready"   # Label that queues an issue for the pipeline
  skip_labels:                     # Issues with any of these labels are skipped
    - "pipeline:blocked"
    - "wontfix"
  max_parallel: 1                  # Max issues processed concurrently (start with 1)
  # Priority: issues labeled p0 are dispatched before p1, before p2, before
  # unlabeled. Apply the labels by hand; bootstrap-labels.sh creates them.

# ── Execution ──────────────────────────────────────────────────────────────
# execution:
#   isolation: worktree          # execution.isolation: worktree (default) --
                                  # each developer/QA stage runs in its own git
                                  # worktree. branch -- stages run in the
                                  # orchestrator's checkout on a per-issue
                                  # branch (serialized, max_parallel: 1 only).
                                  # checkout -- not yet implemented, refused.
#   worktree_warn_threshold: 10  # Non-active worktrees above this count trip a Step 5 warning

# ── Role toggles ─────────────────────────────────────────────────────────────
# developer is always active. Disable roles you don't need to reduce cost.
roles:
  validator: true      # Phase-1 gate — confirms issue is real and in-scope
  pm: true             # Writes the implementation spec before developer starts
  qa: true             # Verifies the PR satisfies acceptance criteria
  reviewer: true       # Code-quality review (correctness, maintainability)
  security: true       # Security review (injection, authz, secrets, SSRF)
  adversarial: false   # Optional pre-merge second opinion (#237) — attacks the diff
                       # for vacuous tests, weak patterns, secret shapes and unverified
                       # claims. Runs after security. Off by default: zero dispatches,
                       # adversarial:approved never required. Typically paired with
                       # agents.roles.adversarial.runner: custom below, e.g. a local
                       # model — cheap enough to run on every PR as a second, truly
                       # independent backend.
  docs: true           # Updates README/docs/CHANGELOG; terminal stage
  planner: false       # Epic decomposition — detects epics (epic label, ≥4 checklist
                       # items, or body ≥2000 chars) and breaks them into dependency-
                       # ordered sub-issues via create-issue. Off by default; enable
                       # only when you regularly work with large, multi-task epics.
  # pm_skip_when_spec_present: true  # Skip PM when issue body already IS a usable
                       # spec (has acceptance-criteria heading with checklist items or
                       # carries spec:ready label). Default true, GitHub only. Set to
                       # false to always run PM on pipeline:confirmed issues.
  # docs_mode: auto      # auto (default) — before dispatching docs, check whether the
                       # developer's own diff already covers it (CHANGELOG.md + README/
                       # docs, or scripts/tests-only with a CHANGELOG entry); if so,
                       # stamp docs:done directly with no subagent dispatch. When docs
                       # does dispatch under auto, it reads only the changed doc paths
                       # + CHANGELOG hunk, not the full diff. Set to "always" to restore
                       # the pre-#200 behavior (docs always dispatches, always reads the
                       # full diff).

# ── Stage comments ───────────────────────────────────────────────────────────
# Each role subagent posts a GitHub comment at its handoff point (Daedalus parity).
# {role} in the header is replaced with the subagent role name at runtime.
# Comment body is rendered from templates/comments/<stage>.md using ${PLACEHOLDER}
# substitution. Set templates_dir to "" to use inline text without templates.
comments:
  enabled: true
  header: "**Agent:** {role} (talos)"
  templates_dir: "templates/comments"    # relative to repo root

# ── Notifications ─────────────────────────────────────────────────────────────
# Priority: incoming webhook env vars > bot tokens from ~/.hermes/.env > silent.
# Slack:   set SLACK_WEBHOOK_URL or use SLACK_BOT_TOKEN from ~/.hermes/.env
# Discord: set DISCORD_WEBHOOK_URL or use DISCORD_BOT_TOKEN from ~/.hermes/.env
# Teams:   set TEAMS_WEBHOOK_URL (webhook-only)
# Buzz:    set BUZZ_RELAY_URL + BUZZ_BOT_PRIVATE_KEY (env, repo .env, or
#          ~/.hermes/.env) and buzz_channel below. Buzz (github.com/block/buzz)
#          is a Nostr relay — delivery publishes a signed kind:9 event via the
#          `nak` CLI (brew install nak); skipped with a warning if nak is absent.
#
# Notification message text is rendered from templates/notifications/$EVENT.md
# when the template file exists. Falls back to the built-in one-liner when absent.
# Set templates_dir to "" to always use the built-in format.
notifications:
  slack_channel: ""          # Slack channel ID; overridden by PIPELINE_SLACK_CHANNEL
  discord_channel: ""        # Discord channel ID; overridden by PIPELINE_DISCORD_CHANNEL
  buzz_channel: ""           # Buzz channel UUID; overridden by PIPELINE_BUZZ_CHANNEL
  # buzz_relay: ""            # notifications.buzz_relay: Buzz (Nostr) relay URL.
                               # Not a secret -- identifies a deployment like
                               # buzz_channel does. Overridden by
                               # PIPELINE_BUZZ_RELAY. Default: "" (unset).
  templates_dir: "templates/notifications"  # relative to repo root; "" disables templates
  threading: true            # Thread all events per issue (bot-token mode only;
                             # silently skipped in webhook mode)
  #
  # cmd (#184): a generic command sink for anything the four platforms above
  # don't cover — a local desktop notifier, a webhook relay, a log shipper.
  # Runs (via sh -c) after Slack/Discord/Teams/Buzz, for every event that
  # passes the events filter below, with this JSON on stdin:
  #   {"event": "pr-opened", "ref": "#42", "message": "...", "thread_key": "42",
  #    "fields": [{"label": "PR", "text": "#9", "url": "https://.../pull/9"}],
  #    "repo": "acme/widget", "issue": 42}
  # A missing command, non-zero exit, or timeout (cmd_timeout_s below) is a
  # silent no-op with one line on stderr — never blocks the pipeline or the
  # other sinks. Disabled by default (empty string).
  # cmd: "my-notify-tool"      # any shell command; "" (default) disables
  # cmd_timeout_s: 10          # seconds before the command is killed; must
  #                            # be a positive integer (default 10)
  #
  # events: LEAVE THIS COMMENTED OUT to fire all events (recommended).
  #
  # WARNING — if you enable the events filter you MUST include the role events
  # (validator/developer/qa/reviewer/security/docs/orchestrator) or the
  # conversation stream is silently killed. Lifecycle-only lists like
  # [pr-opened, merged, blocked, issue-closed] drop all role events with zero
  # feedback — the Slack/Discord thread goes silent after the first message.
  #
  # Full list you should copy when enabling:
  #   - validator
  #   - developer
  #   - qa
  #   - reviewer
  #   - security
  #   - docs
  #   - orchestrator
  #   - pr-opened
  #   - merged
  #   - blocked
  #   - issue-closed
  #   - info
  #
  # events:

# ── Agent runner / subagents ───────────────────────────────────────────────────
# How role stages execute depends on the harness:
#   agents.subagents: auto | true | false   (default auto)
#     true   = native parallel subagents (Claude Code only)
#     false  = run stages without subagents
#     auto   = true when agents.runner is claude, else false
#
#   agents.runner selects the harness (claude | pi | codex | gemini | antigravity | custom):
#     claude      → native subagents (subagents: true)
#     pi          → INLINE one-agent-per-turn: the pi session acts as each stage
#                   role itself, one role per turn (subagents: false). No
#                   pipeline-agent.sh, no subprocesses. Works on any provider
#                   backing pi (Claude account, local LLM).
#     codex/gemini/antigravity/custom → headless per-stage via pipeline-agent.sh
#                   (subagents: false).
#
# Claude Code spawns native subagents and ignores this section except that it
# still honours agents.subagents. Harnesses without subagents execute role
# stages as above.
# agents:
#   runner: pi                 # claude (default) | pi | codex | gemini | antigravity | custom
#   subagents: auto            # auto | true | false
#   # runner_args:             # extra CLI args for the claude/pi/codex/gemini runner
#   #   - --full-auto
#   # runner_cmd: "my-agent-cli"  # runner: custom — prompt arrives on stdin.
#   #                             # Must be an AGENTIC CLI (executes shell/edits
#   #                             # files); use one backed by a local model
#   #                             # (e.g. Ollama) for fully local pipelines.
#
# Per-role runner override (agents.roles.<role>.runner / .runner_cmd): a role
# can be pointed at a different backend from the pipeline default, on both
# the native and adapter execution paths — resolved role-first (the role's
# own key wins, else the global agents.runner/.runner_cmd above). No
# agents.roles.<role>.runner_args in this release — runner_args stays
# global-only. `bash scripts/pipeline-agent.sh --resolve <role>` prints what
# a role will actually use.
#   roles:
#     security:
#       runner: custom                # this role only; everything else stays claude
#       # runner_cmd: |               # second opinion via a local llama.cpp model
#       #   OPENAI_API_BASE=http://localhost:8080/v1 OPENAI_API_KEY=local \
#       #     aider --model openai/local --yes-always --no-auto-commits --message "$(cat)"
#
# Adversarial pre-merge stage on a second, local backend (#237): pair
# roles.adversarial: true above with its own runner so the diff gets a
# genuinely independent review — start the endpoint (--jinja enables
# tool/function calling, needed by any agentic CLI):
#   llama-server -m qwen2.5-coder-32b-instruct-q4_k_m.gguf --port 8081 -c 32768 --jinja
#     adversarial:
#       runner: custom
#       # runner_cmd points at a wrapper script, not the endpoint directly —
#       # the wrapper reads the prompt from stdin and forwards it to the
#       # OpenAI-compatible endpoint via an agentic CLI:
#       #   #!/usr/bin/env bash
#       #   set -euo pipefail
#       #   OPENAI_API_BASE=http://localhost:8081/v1 OPENAI_API_KEY=local \
#       #     aider --model openai/local --yes-always --no-auto-commits --message "$(cat)"
#       # runner_cmd: "/path/to/adversarial-runner.sh"
#
# Per-role model selection (native path only): agents.model sets a global
# default; agents.roles.<role>.model overrides a single role, else falls
# back to agents.model, else the session default.
#   model: claude-haiku-4-5-20251001   # volume stages: developer, qa, docs, ...
#   roles:
#     reviewer:
#       model: claude-opus-5           # judgement stages
#
# Re-stamp model (agents.restamp_model / agents.roles.<role>.restamp_model,
# #258): when a role's approval goes stale (check-approval-sha --stale-list)
# purely because a later commit landed, the orchestrator re-reviews only the
# delta instead of the whole diff again -- a cheap "re-stamp" dispatch, not
# a full stage. Precedence: role restamp_model → global restamp_model →
# agents.model (falls back to the same volume tier as agents.model, not the
# session default). Unset by default -- no behaviour change until set.
#   restamp_model: claude-haiku-4-5-20251001
#   roles:
#     security:
#       restamp_model: claude-haiku-4-5-20251001   # even if security itself runs opus

# ── Hooks ─────────────────────────────────────────────────────────────────────
# hooks.pre_dispatch (#181): a shell command run before EVERY stage's prompt
# is built (validator, PM, developer, QA, reviewer, security, docs, planner —
# both the native subagent path and the pipeline-agent.sh adapter path). Lets
# an external tool (project memory, a cost budget, a style guide, anything)
# contribute context to a stage without Talos depending on it. Disabled by
# default (empty — no command runs, nothing is added to any prompt).
#
# The command receives this JSON on stdin (fields the caller doesn't know yet,
# e.g. pr/files_hint before a PR exists, are null/[] rather than omitted):
#   {"role":"developer","issue":42,"pr":57,"repo":"owner/name",
#    "base_branch":"main","worktree_path":"/abs/path","files_hint":["a.sh"]}
# TALOS_ROLE, TALOS_ISSUE_NUMBER, and TALOS_WORKTREE_PATH are also exported.
#
# Non-zero exit, a timeout (hooks.timeout_s below), or empty stdout is a
# silent no-op — the prompt is unmodified — with one line on stderr. Never
# blocks dispatch. Non-empty stdout is prepended to the prompt under a
# "## Context" heading. See scripts/pipeline-hooks.sh for the full contract.
#
# hooks.post_stage (#182): a shell command run after EVERY verdict, approval,
# block, and merge — the outcome-side counterpart to hooks.pre_dispatch.
# Fire-and-forget, same never-block contract: lets an external tool (metrics,
# cost tracking, a project memory) subscribe to every structured outcome the
# moment it's known, without Talos depending on it. Disabled by default.
#
# The command receives this JSON on stdin (fields the caller didn't supply,
# e.g. sha/verdict/attempt before they're known, are null rather than
# omitted):
#   {"event":"qa","role":"qa","issue":42,"pr":57,"repo":"owner/name",
#    "sha":"<40hex or null>","verdict":"PASS","summary":"...","details":"...",
#    "attempt":{"stage":"qa","count":1,"total":3},"model":"claude-sonnet-5",
#    "runner":"claude","duration_s":312,"ts":"2026-09-07T14:00:00Z"}
# TALOS_ROLE and TALOS_ISSUE_NUMBER are also exported. Non-zero exit or a
# timeout (hooks.timeout_s) is a silent no-op with one line on stderr.
# hooks:
#   pre_dispatch: "my-context-tool"  # any shell command; "" (default) disables
#   post_stage: "my-outcome-sink"    # any shell command; "" (default) disables
#   timeout_s: 30                    # seconds before either hook is killed;
#                                     # must be a positive integer (default 30)

# ── Local events log (#183) ────────────────────────────────────────────────────
# Every post_stage payload (same schema as hooks.post_stage above) is also
# appended, as one JSON line, to a local audit log -- independently of
# whether hooks.post_stage is configured at all. Gitignored by default
# (.talos/ is in .gitignore). Read it with:
#   bash scripts/pipeline-events.sh list [--issue N] [--role R] [--event E] [--last K] [--json]
#   bash scripts/pipeline-events.sh tail [--issue N]
#   bash scripts/pipeline-events.sh path
# events:
#   enabled: true                    # default true; false disables the log entirely
#   path: ".talos/events.jsonl"      # relative to the MAIN repository root (shared
#                                     # by every linked worktree via `git rev-parse
#                                     # --git-common-dir`) unless already absolute

# ── Safety limits ─────────────────────────────────────────────────────────────
limits:
  max_fix_attempts: 3        # Developer re-tries before escalating to pipeline:blocked
  # max_total_dispatches: 8    # limits.max_total_dispatches: absolute ceiling
                                # on total developer dispatches per issue, across
                                # all stage changes -- never resets, even when
                                # the blocking stage changes. Default: 8.
  max_retries: 5             # Retries per network call after a rate-limit / transient
                             # error, on top of the original try (up to 6 total attempts
                             # by default). Applies to gh/glab/az CLI invocations and
                             # the github-api provider's curl requests. Retried: HTTP
                             # 429, GitHub 403 secondary-rate-limit/abuse-detection,
                             # gh/glab/az CLI errors with explicit rate-limit phrases
                             # only (e.g. "HTTP 429", never bare numbers). Not retried:
                             # 401/404/422/etc. Backoff: Retry-After header (capped at
                             # 60s) when supplied, else exponential 2s to 60s — both
                             # capped at 60s. Must be a non-negative integer; non-numeric
                             # value warns and defaults to 5. Set
                             # TALOS_RETRY_SLEEP_SCALE=0 in tests for instant runs.

# ── Approval-marker author trust (#187) ────────────────────────────────────────
# check-approval-sha / read-attempt only trust talos:approval / talos:attempt
# markers from an effective trust set. As of #187 that defaults ON:
# markers.verify_authors: true infers the identity Talos itself is
# authenticated as (gh api user --jq .login for the github provider; GET
# /user for github-api) and unions it with markers.trusted_authors below --
# no config required to close the "one stage posts all its own approval
# markers" gap. A bot login is never trusted implicitly for just looking like
# a bot -- it must be that inferred identity, or be listed explicitly below.
# markers:
#   verify_authors: false       # opt out entirely: accept any commenter's
#                                # marker, silently, exactly as before #187
#   trusted_authors:             # ADDITIONAL logins to trust, unioned with
#     - "github-actions[bot]"    # (not replacing) the inferred identity --
#     - "talos-bot"               # e.g. a separate CI job's bot account
