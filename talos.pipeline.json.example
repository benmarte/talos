{
  "_note": "talos.pipeline.json — recommended for new projects (no PyYAML dependency). Copy to your repo root as talos.pipeline.json and edit for your project. Config file lookup order: $PIPELINE_CONFIG env var, talos.pipeline.yml, talos.pipeline.yaml, talos.pipeline.json, .claude-pipeline.yaml, .claude-pipeline.json, pipeline.yaml, pipeline.json. JSON has no comment syntax, so commented-out example keys (see talos.pipeline.yml.example) are described here instead of shown inline: execution.worktree_warn_threshold (default 10) sets the non-active worktree count above which the Step 5 end-of-run sweep warns, e.g. \"execution\": {\"worktree_warn_threshold\": 10}; limits.max_retries (default 5) sets retries per network call after a rate-limit/transient error (must be a non-negative integer), on top of the original try (up to 6 total attempts by default); Retry-After is honored but capped at 60s, e.g. \"limits\": {\"max_retries\": 5}. verify.qa_mode (ci | local, default ci when merge.required_checks below is non-empty else local) makes QA trust CI instead of re-running the verify list above locally, e.g. \"verify\": {\"qa_mode\": \"ci\"}; verify.targeted (default true) makes the developer run only the tests covering its changed files while iterating, then the full verify list once before its final commit, e.g. \"verify\": {\"targeted\": true}; verify.ci_wait_s (default 900) bounds how long QA waits in the foreground for merge.required_checks to go green under qa_mode: ci, e.g. \"verify\": {\"ci_wait_s\": 900}.",

  "base_branch": "dev",

  "vcs": {
    "provider": "github"
  },

  "release_branch": "main",

  "board": {
    "enabled": true,
    "project_number": 1,
    "owner": "myorg",
    "status_field": "Status",
    "statuses": {
      "ready": "Ready",
      "in_progress": "In progress",
      "in_review": "In review",
      "done": "Done",
      "blocked": "Blocked"
    }
  },

  "verify": [
    "python -m pytest tests/ -x -q"
  ],

  "merge": {
    "auto": true,
    "method": "squash",
    "required_checks": [
      "test"
    ],
    "delete_branch": true,
    "approval_waiver_paths": [
      "*.md",
      "docs/**",
      "CHANGELOG.md"
    ]
  },

  "issues": {
    "label_filter": "pipeline:ready",
    "skip_labels": [
      "pipeline:blocked",
      "wontfix"
    ],
    "max_parallel": 1
  },

  "roles": {
    "validator": true,
    "pm": true,
    "qa": true,
    "reviewer": true,
    "security": true,
    "docs": true,
    "planner": false
  },

  "comments": {
    "enabled": true,
    "header": "**Agent:** {role} (talos)",
    "templates_dir": "templates/comments"
  },

  "notifications": {
    "slack_channel": "",
    "discord_channel": "",
    "buzz_channel": "",
    "templates_dir": "templates/notifications",
    "threading": true
  },

  "limits": {
    "max_fix_attempts": 3,
    "max_retries": 5
  }
}
