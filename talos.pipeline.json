{
  "base_branch": "main",
  "vcs": {
    "provider": "github"
  },
  "board": {
    "enabled": true,
    "project_number": 4,
    "owner": "benmarte"
  },
  "issues": {
    "label_filter": "pipeline:ready",
    "skip_labels": [
      "pipeline:blocked",
      "wontfix"
    ],
    "max_parallel": 1
  },
  "roles": {
    "validator": true,
    "pm": true,
    "qa": true,
    "reviewer": true,
    "security": true,
    "docs": true
  },
  "verify": [
    "bash tests/run-tests.sh"
  ],
  "merge": {
    "method": "squash",
    "required_checks": [
      "test (ubuntu-latest)",
      "test (macos-latest)"
    ],
    "delete_branch": true,
    "approval_waiver_paths": [
      "*.md",
      "docs/**",
      "CHANGELOG.md"
    ]
  },
  "limits": {
    "max_fix_attempts": 3,
    "max_total_dispatches": 8
  },
  "agents": {
    "model": "claude-haiku-4-5-20251001",
    "roles": {
      "developer": {
        "model": "claude-sonnet-5"
      },
      "pm": {
        "model": "claude-sonnet-5"
      },
      "qa": {
        "model": "claude-sonnet-5"
      },
      "reviewer": {
        "model": "claude-sonnet-5"
      },
      "security": {
        "model": "claude-sonnet-5"
      }
    }
  }
}
