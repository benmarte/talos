SCRIPTS_DIR=<scripts>
AGENT_SOURCE=repo override (.claude/agents/)
BASE_BRANCH=main
VCS_PROVIDER=github
BOARD_ENABLED=true
PROJECT_NUMBER=7
BOARD_OWNER=acme
MAX_PARALLEL=2
MAX_FIX_ATTEMPTS=5
LABEL_FILTER=pipeline:ready
SKIP_LABELS=pipeline:blocked\nwontfix\nhold
MERGE_AUTO=false
MERGE_AUTO_SYNC=false
MERGE_REQUIRED_CHECKS=ci / test\nci / lint
VERIFY_COMMANDS=bash tests/run-tests.sh --quiet\nbash lint.sh
VERIFY_QA_MODE=ci
VERIFY_TARGETED=false
VERIFY_CI_WAIT_S=600
VERIFY_TIMEOUT_MS=300000
ROLE_VALIDATOR=true
ROLE_PM=true
ROLE_QA=true
ROLE_REVIEWER=true
ROLE_SECURITY=true
ROLE_DOCS=true
ROLE_PLANNER=true
ROLE_ADVERSARIAL=true
ROLE_PM_SKIP_WHEN_SPEC_PRESENT=false
ROLE_CHANGELOG_FRAGMENTS=true
ROLE_DOCS_MODE=always
STATUS_ENABLED=true
STATUS_FILE=TALOS_STATUS.md
STATUS_FRAGMENTS_DIR=docs/status.d
COMMENTS_ENABLED=true
COMMENTS_HEADER_TPL=**Agent:** {role} (talos)
COMMENTS_TMPL_DIR=tpl/comments
SPEND_COMMENT=false
AGENTS_RUNNER=claude
AGENTS_SUBAGENTS=auto
FILE_SOURCE_PATH=plan.md
ISOLATION=worktree
WORKTREE_WARN_THRESHOLD=4
PR_DRAFT=true
EVIDENCE_ENABLED=true
EVIDENCE_LINE=evidence on when=always mode=command
agent.validator.runner=claude
agent.validator.model=sonnet
agent.validator.effort=medium
agent.validator.fallback=codex
agent.pm.runner=claude
agent.pm.model=sonnet
agent.pm.effort=medium
agent.pm.fallback=codex
agent.developer.runner=custom
agent.developer.runner_cmd=my-runner --flag "a b" model=x effort=max
agent.developer.model=sonnet
agent.developer.effort=medium
agent.developer.fallback=codex
agent.qa.runner=claude
agent.qa.model=sonnet
agent.qa.effort=high
agent.qa.fallback=codex
agent.qa.effort_notice=talos: notice: role 'qa' has effort=high in config but its frontmatter has effort=low -- native path uses the committed frontmatter; config effort is advisory here
agent.reviewer.runner=claude
agent.reviewer.model=sonnet
agent.reviewer.effort=medium
agent.reviewer.fallback=codex
agent.security.runner=claude
agent.security.model=opus
agent.security.effort=medium
agent.security.fallback=codex
agent.adversarial.runner=claude
agent.adversarial.model=sonnet
agent.adversarial.effort=medium
agent.adversarial.fallback=codex
agent.docs.runner=claude
agent.docs.model=haiku
agent.docs.effort=medium
agent.docs.fallback=codex
agent.planner.runner=claude
agent.planner.model=sonnet
agent.planner.effort=medium
agent.planner.fallback=codex
