SCRIPTS_DIR=<scripts>
AGENT_SOURCE=global/bare (~/.claude/agents/ or none)
BASE_BRANCH=main
VCS_PROVIDER=github
BOARD_ENABLED=true
PROJECT_NUMBER=
BOARD_OWNER=
MAX_PARALLEL=1
MAX_FIX_ATTEMPTS=3
LABEL_FILTER=pipeline:ready
SKIP_LABELS=pipeline:blocked\nwontfix
MERGE_AUTO=true
MERGE_AUTO_SYNC=true
MERGE_REQUIRED_CHECKS=
VERIFY_COMMANDS=
VERIFY_QA_MODE=local
VERIFY_TARGETED=true
VERIFY_CI_WAIT_S=900
VERIFY_TIMEOUT_MS=600000
ROLE_VALIDATOR=true
ROLE_PM=true
ROLE_QA=true
ROLE_REVIEWER=true
ROLE_SECURITY=true
ROLE_DOCS=true
ROLE_PLANNER=false
ROLE_ADVERSARIAL=false
ROLE_PM_SKIP_WHEN_SPEC_PRESENT=true
ROLE_CHANGELOG_FRAGMENTS=false
ROLE_DOCS_MODE=auto
STATUS_ENABLED=false
STATUS_FILE=TALOS_STATUS.md
STATUS_FRAGMENTS_DIR=docs/status.d
COMMENTS_ENABLED=true
COMMENTS_HEADER_TPL=**Agent:** {role} (talos)
COMMENTS_TMPL_DIR=templates/comments
SPEND_COMMENT=true
AGENTS_RUNNER=claude
AGENTS_SUBAGENTS=auto
FILE_SOURCE_PATH=plan.md
ISOLATION=worktree
WORKTREE_WARN_THRESHOLD=10
PR_DRAFT=true
EVIDENCE_ENABLED=false
EVIDENCE_LINE=
agent.validator.runner=claude
agent.pm.runner=claude
agent.developer.runner=claude
agent.qa.runner=claude
agent.reviewer.runner=claude
agent.security.runner=claude
agent.adversarial.runner=claude
agent.docs.runner=claude
agent.planner.runner=claude
