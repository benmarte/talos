#!/usr/bin/env bash
# curl stub for talos tests. Logs "URL<tab>PAYLOAD[<tab>AUTH]" to $CURL_LOG.
# Response: pops the first line of $CURL_QUEUE if non-empty, otherwise a
# platform default (Slack ok+ts / Discord message id) keyed off the URL.
#
# Extensions for github-api tests (backward-compatible):
#   - When an Authorization: Bearer header is present, appends
#     "Authorization: Bearer" as a third tab-separated field on the same log
#     line. Existing tests use cut -f2 (payload) so the third field is ignored.
#     New tests can grep/assert_contains "$CURL_LOG" "Authorization: Bearer".
#   - Appends "200" as a final output line when -w is passed so callers using
#     `curl -w "\n%{http_code}"` can parse HTTP status from the last line.
#   - When -D <file> is passed, writes a minimal HTTP response header block
#     including X-RateLimit-Reset: ${CURL_RATE_LIMIT_RESET:-0} to that file.
#     Default CURL_RATE_LIMIT_RESET=0 keeps existing tests unbroken.
#   - CURL_RETRY_AFTER: when set (non-empty), adds a Retry-After: <value>
#     header to the -D response block (#194). Unset by default -- no header,
#     same as before.
#   - CURL_LINK_QUEUE: optional file whose lines are Link: next URLs (one per
#     call). When non-empty the first line is popped and written as a Link
#     header in the -D response block; an empty line means no Link header for
#     that call. Enables pagination simulation without modifying the stub.
#   - GET .../user (#187, _ga_current_user_login) is intercepted BEFORE the
#     CURL_QUEUE pop below, on the URL alone -- never consumes a queue slot --
#     so every pre-#187 test's CURL_QUEUE sequencing for its own endpoint(s)
#     is unaffected whether or not it ever anticipated this call. Override
#     STUB_CURRENT_USER (bare login, default "talos-test-bot" when unset; set to
#     "" for an answer with an empty login, which is refused (#455)) or STUB_CURRENT_USER_JSON (raw response body, for
#     malformed-response tests).
#   - Issue assignees (#299, assign-issue): when STUB_ASSIGNEE_FILE is set,
#     GET .../issues/<n> and POST .../issues/<n>/assignees are intercepted
#     (again BEFORE the CURL_QUEUE pop) against that file's contents -- the
#     issue's current assignee, absent/empty = unassigned. POST honours
#     STUB_ASSIGN_FAIL=1 (HTTP 422) and STUB_ASSIGN_DROP=1 (201, but the
#     assignee never lands -- GitHub's real behaviour for a non-collaborator).

#   - upsert-pr-comment (#381): `--data-binary @-` reads the payload from STDIN
#     and logs it as field 2, exactly like -d; the HTTP method (-X) is a 4th
#     log field, after the auth field, so cut -f1..3 consumers are unaffected.
#     $CURL_ARGV_LOG, when set, gets one line per call with the raw argv, so a
#     test can prove a body never touched argv. With STUB_COMMENT_STORE (a JSON
#     array file) GET .../issues/<n>/comments serves it, POST appends a comment
#     by $STUB_CURRENT_USER and PATCH .../issues/comments/<id> edits one in
#     place (all before the CURL_QUEUE pop). STUB_COMMENT_READ_FAIL=1 fails the
#     read (500); STUB_COMMENT_WRITE_FAIL=1 fails every write (500);
#     STUB_COMMENT_WRITE_429=<N> rate-limits the first N writes (429).
#     STUB_CURRENT_USER_STATUS=<code> makes GET .../user answer with that HTTP
#     status (403 is what an Actions GITHUB_TOKEN gets).
#   - Config on stdin (#443): `-K -` reads curl config lines from STDIN, the way
#     pipeline-notify.sh's post() hands over a webhook URL or bot token so it
#     never reaches argv. `url = "..."` is the request URL (instead of the last
#     argument) and `header = "..."` is treated like -H (Bearer logged as the
#     auth field); \\ and \" are unescaped. The config is not logged, except
#     each header line to $CURL_HDR_LOG when a test sets it.
#   - Failure modes (#451). STUB_CURL_FAIL_RC=<n> makes the stub log the call and
#     exit <n> with no output at all, the way a transport failure (7 = connection
#     refused, 28 = timeout) looks to the caller; STUB_CURL_FAIL_METHOD=<verb>
#     limits that to calls whose -X is <verb>. Any single argv element over
#     STUB_CURL_ARGV_MAX bytes (default 131072, Linux's MAX_ARG_STRLEN) fails like
#     exec's E2BIG: the call is logged to $CURL_BIGARG_LOG (when set), the stub
#     prints "Argument list too long" and exits 126 -- macOS has no such limit, so
#     without this a body on argv would pass locally and fail only in CI.

# One argv element over the Linux limit: refuse before doing anything else.
_argv_max="${STUB_CURL_ARGV_MAX:-131072}"
for arg in "$@"; do
  # ${#arg} counts characters, which never exceed bytes, so only an element
  # long enough to matter pays for the byte count.
  if [ "${#arg}" -gt $((_argv_max / 4)) ] \
     && [ "$(printf '%s' "$arg" | LC_ALL=C wc -c | tr -d ' ')" -gt "$_argv_max" ]; then
    [ -n "${CURL_BIGARG_LOG:-}" ] && printf 'BIGARG\n' >> "$CURL_BIGARG_LOG"
    echo "curl stub: Argument list too long" >&2
    exit 126
  fi
done

payload=""
url=""
prev=""
cfg_in=""
has_w=false
method=""
auth_field=""
hdr_file=""
for arg in "$@"; do
  [ "$prev" = "-d" ] && payload="$arg"
  [ "$prev" = "--data-binary" ] && [ "$arg" = "@-" ] && payload="$(cat)"
  [ "$prev" = "-K" ] && [ "$arg" = "-" ] && cfg_in="$(cat)"
  [ "$prev" = "-w" ] && has_w=true
  [ "$prev" = "-D" ] && hdr_file="$arg"
  [ "$prev" = "-X" ] && method="$arg"
  if [ "$prev" = "-H" ]; then
    case "$arg" in
      "Authorization: Bearer "*) auth_field="Authorization: Bearer" ;;
    esac
  fi
  prev="$arg"
done
# URL = last argument, unless a config on stdin (-K -) supplied one (#443)
for arg in "$@"; do url="$arg"; done
_cfg_unquote() {  # `key = "value"` -> value, with \" and \\ unescaped
  local v="${1#*\"}"
  v="${v%\"*}"
  v="${v//\\\"/\"}"
  printf '%s' "${v//\\\\/\\}"
}
if [ -n "$cfg_in" ]; then
  while IFS= read -r _cfg_line; do
    case "$_cfg_line" in
      'url = "'*) url="$(_cfg_unquote "$_cfg_line")" ;;
      'header = "'*)
        # $CURL_HDR_LOG, when set, gets each config header, so a test can prove a
        # token arrived (grep -q) without ever printing it.
        [ -n "${CURL_HDR_LOG:-}" ] && printf '%s\n' "$(_cfg_unquote "$_cfg_line")" >> "$CURL_HDR_LOG"
        case "$_cfg_line" in
          'header = "Authorization: Bearer '*) auth_field="Authorization: Bearer" ;;
        esac ;;
    esac
  done <<EOF_CFG
$cfg_in
EOF_CFG
fi

# Log: one line per call — URL TAB payload TAB auth-field
[ -n "${CURL_LOG:-}" ] && printf '%s\t%s\t%s\t%s\n' "$url" "$payload" "$auth_field" "$method" >> "$CURL_LOG"
[ -n "${CURL_ARGV_LOG:-}" ] && printf '%s\n' "$*" >> "$CURL_ARGV_LOG"

# Transport failure (#451): logged above, then nothing on stdout, like curl.
if [ -n "${STUB_CURL_FAIL_RC:-}" ] \
   && { [ -z "${STUB_CURL_FAIL_METHOD:-}" ] || [ "$method" = "$STUB_CURL_FAIL_METHOD" ]; }; then
  echo "curl: (${STUB_CURL_FAIL_RC}) stub transport failure" >&2
  exit "$STUB_CURL_FAIL_RC"
fi

# HTTP status to emit when -w was requested (default 200).
# If a CURL_QUEUE entry is a bare 3-digit number it is treated as a status
# override (empty body). A "<status>:<body>" entry (#173, e.g. for simulating
# GitHub's 403 secondary-rate-limit body) overrides both. All other queue
# entries are response bodies with the default 200 status.
http_status=200
resp=""
if [[ "$url" == *"/user" && "$url" != *"/users/"* ]]; then
  resp="${STUB_CURRENT_USER_JSON:-$(printf '{"login":"%s"}' "${STUB_CURRENT_USER-talos-test-bot}")}"
  if [ -n "${STUB_CURRENT_USER_STATUS:-}" ]; then
    http_status="$STUB_CURRENT_USER_STATUS"
    resp='{"message":"Resource not accessible by integration"}'
  fi
elif [ -n "${STUB_COMMENT_STORE:-}" ] && [ -e "$STUB_COMMENT_STORE" ] && { [[ "$url" =~ /issues/([0-9]+)/comments(\?.*)?$ ]] || [[ "$url" =~ /issues/comments/([0-9]+)$ ]]; }; then
  _cs_n="${BASH_REMATCH[1]}"
  if [ "$method" != "POST" ] && [ "$method" != "PATCH" ]; then
    if [ "${STUB_COMMENT_READ_FAIL:-}" = "1" ]; then
      http_status=500
      resp='{"message":"Server Error"}'
    elif [ -s "$STUB_COMMENT_STORE" ]; then
      resp="$(cat "$STUB_COMMENT_STORE")"
    else
      resp='[]'
    fi
  else
    _cs_fail=""
    if [ -n "${STUB_COMMENT_WRITE_429:-}" ]; then
      # Next to the log, so parallel tests never share state; no log, no counter.
      if [ -z "${CURL_LOG:-}" ]; then
        echo "curl stub: STUB_COMMENT_WRITE_429 needs CURL_LOG set" >&2
        exit 1
      fi
      _cs_counter="$CURL_LOG.w429"
      _cs_count=0
      [ -f "$_cs_counter" ] && _cs_count="$(cat "$_cs_counter")"
      _cs_count=$((_cs_count + 1))
      printf '%s' "$_cs_count" > "$_cs_counter"
      if [ "$_cs_count" -le "$STUB_COMMENT_WRITE_429" ]; then
        http_status=429
        resp='{"message":"API rate limit exceeded"}'
        _cs_fail=1
      fi
    fi
    if [ -z "$_cs_fail" ] && [ "${STUB_COMMENT_WRITE_FAIL:-}" = "1" ]; then
      http_status=500
      resp='{"message":"Server Error"}'
      _cs_fail=1
    fi
    if [ -z "$_cs_fail" ]; then
      _cs_payload="$(mktemp)" || exit 1
      printf '%s' "$payload" > "$_cs_payload"
      resp="$(python3 -I -c "
import json, os, sys
store, op, url, n, pfile, user = sys.argv[1:7]
items = json.load(open(store)) if os.path.getsize(store) else []
body = json.load(open(pfile))['body']
if op == 'POST':
    nid = max([c['id'] for c in items] + [5000]) + 1
    c = {'id': nid, 'user': {'login': user}, 'body': body,
         'created_at': '2026-10-03T00:%02d:00Z' % (len(items) % 60),
         'html_url': 'https://github.com/acme/widget/pull/%s#issuecomment-%d' % (n, nid)}
    items.append(c)
else:
    c = next(x for x in items if x['id'] == int(n))
    c['body'] = body
json.dump(items, open(store, 'w'))
print(json.dumps(c))
" "$STUB_COMMENT_STORE" "$method" "$url" "$_cs_n" "$_cs_payload" "${STUB_CURRENT_USER:-}")"
      rm -f "$_cs_payload"
    fi
  fi
elif [ -n "${STUB_ASSIGNEE_FILE:-}${STUB_ASSIGNEE_DIR:-}" ] && [[ "$url" =~ /issues/([0-9]+)/assignees$ ]]; then
  # POST adds an assignee (#299); DELETE removes the named ones (#560). With
  # STUB_ASSIGNEE_DIR (#560) the state is one file per issue ($DIR/<n>, one
  # login per line) and a POST adds to it; STUB_ASSIGNEE_RACER=<login> adds a
  # second operator whose write lands at the same moment.
  _as_f="${STUB_ASSIGNEE_FILE:-}"
  [ -n "${STUB_ASSIGNEE_DIR:-}" ] && _as_f="$STUB_ASSIGNEE_DIR/${BASH_REMATCH[1]}"
  if [ "${STUB_ASSIGN_FAIL:-}" = "1" ]; then
    http_status=422
    resp='{"message":"Validation Failed"}'
  elif [ "$method" = "DELETE" ]; then
    [ -f "$_as_f" ] && printf '%s' "$payload" | python3 -I -c "
import json, sys
gone = [x.lower() for x in json.load(sys.stdin)['assignees']]
path = sys.argv[1]
keep = [l for l in open(path).read().split() if l.lower() not in gone]
open(path, 'w').write(''.join(l + '\\n' for l in keep))
" "$_as_f"
    http_status=200
    resp='{}'
  else
    if [ "${STUB_ASSIGN_DROP:-}" != "1" ]; then
      printf '%s' "$payload" | STUB_RACER="${STUB_ASSIGNEE_RACER:-}" ADD="${STUB_ASSIGNEE_ADD:-}${STUB_ASSIGNEE_DIR:+1}" python3 -I -c "
import json, os, sys
path = sys.argv[1]
new = json.load(sys.stdin)['assignees'][0]
cur = open(path).read().split() if os.path.exists(path) else []
out = (cur if os.environ['ADD'] else []) + [new]
if os.environ['STUB_RACER']:
    out.append(os.environ['STUB_RACER'])
seen, keep = set(), []
for l in out:
    if l.lower() not in seen:
        seen.add(l.lower())
        keep.append(l)
open(path, 'w').write(''.join(l + '\\n' for l in keep))
" "$_as_f"
    fi
    http_status=201
    resp='{}'
  fi
elif [ -n "${STUB_ASSIGNEE_FILE:-}${STUB_ASSIGNEE_DIR:-}" ] && [ "$method" = "GET" ] && [[ "$url" =~ /issues/([0-9]+)$ ]]; then
  _as_f="${STUB_ASSIGNEE_FILE:-}"
  [ -n "${STUB_ASSIGNEE_DIR:-}" ] && _as_f="$STUB_ASSIGNEE_DIR/${BASH_REMATCH[1]}"
  _as_cur=""
  [ -s "$_as_f" ] && _as_cur="$(cat "$_as_f")"
  resp="$(CUR="$_as_cur" python3 -I -c "
import json, os
cur = os.environ['CUR'].split()
print(json.dumps({'number': 42, 'assignees': [{'login': c} for c in cur]}))
")"
elif [ -n "${CURL_QUEUE:-}" ] && [ -s "$CURL_QUEUE" ]; then
  raw="$(head -1 "$CURL_QUEUE")"
  tail -n +2 "$CURL_QUEUE" > "$CURL_QUEUE.tmp" && mv "$CURL_QUEUE.tmp" "$CURL_QUEUE"
  case "$raw" in
    [0-9][0-9][0-9])
      http_status="$raw"
      resp="" ;;
    [0-9][0-9][0-9]:*)
      http_status="${raw%%:*}"
      resp="${raw#*:}" ;;
    *)
      resp="$raw" ;;
  esac
else
  case "$url" in
    *slack.com*)   resp='{"ok":true,"ts":"1111.2222"}' ;;
    *discord.com*) resp='{"id":"900000000000000001"}' ;;
    *)             resp='{}' ;;
  esac
fi

# CURL_QUEUE holds one response body per line, so a queue entry cannot
# contain a literal newline. Tests that need a pretty-printed (multi-line)
# response body -- matching the live GitHub REST API shape (#244) -- encode
# embedded newlines as the control byte \x01 before queuing; decode back to
# real newlines here. \x01 cannot appear in valid JSON text, so this is a
# no-op for every pre-existing single-line queue entry.
resp="${resp//$'\x01'/$'\n'}"

# Pop one Link: next URL from CURL_LINK_QUEUE (empty line = no Link header)
link_next=""
if [ -n "${CURL_LINK_QUEUE:-}" ] && [ -f "$CURL_LINK_QUEUE" ] && [ -s "$CURL_LINK_QUEUE" ]; then
  link_next="$(head -1 "$CURL_LINK_QUEUE")"
  tail -n +2 "$CURL_LINK_QUEUE" > "$CURL_LINK_QUEUE.tmp" \
    && mv "$CURL_LINK_QUEUE.tmp" "$CURL_LINK_QUEUE"
fi

# Write minimal response headers when -D <file> was requested
if [ -n "$hdr_file" ]; then
  hdr_block="HTTP/1.1 $http_status\r\nX-RateLimit-Reset: ${CURL_RATE_LIMIT_RESET:-0}\r\n"
  [ -n "${CURL_RETRY_AFTER:-}" ] && hdr_block="${hdr_block}Retry-After: ${CURL_RETRY_AFTER}\r\n"
  [ -n "$link_next" ] && hdr_block="${hdr_block}Link: <${link_next}>; rel=\"next\"\r\n"
  printf '%b\r\n' "$hdr_block" > "$hdr_file"
fi

[ -n "$resp" ] && printf '%s\n' "$resp"
# Append HTTP status code on its own line when -w was requested
[ "$has_w" = "true" ] && printf '%s\n' "$http_status"
exit 0
