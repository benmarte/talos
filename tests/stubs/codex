#!/usr/bin/env bash
# codex CLI stub for talos tests. Logs "argv<US>...<US>" plus the prompt to
# $RUNNER_LOG so tests can assert both the flags and the assembled prompt.
{
  printf 'CODEX ARGS:'; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'
} >> "${RUNNER_LOG:-/dev/null}"
# Failover tests (#418), all default-off: STUB_CODEX_HOOK is eval'd (a stage
# that writes before dying), _STDERR / _STDOUT replace the output, _EXIT is the
# exit code, STUB_PROMPT_DIR keeps the last argv element (the prompt) per runner.
[ -z "${STUB_PROMPT_DIR:-}" ] || printf '%s' "${@: -1}" > "$STUB_PROMPT_DIR/codex.prompt"
[ -z "${STUB_CODEX_HOOK:-}" ] || eval "$STUB_CODEX_HOOK"
[ -z "${STUB_CODEX_STDERR:-}" ] || printf '%s\n' "$STUB_CODEX_STDERR" >&2
echo "${STUB_CODEX_STDOUT:-codex-stub-ok}"
exit "${STUB_CODEX_EXIT:-0}"
