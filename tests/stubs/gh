#!/usr/bin/env bash
# gh stub for talos tests. Logs every invocation to $GH_LOG and returns
# canned responses for the query shapes the pipeline scripts use.
# Override values with: STUB_REPO (owner/name), STUB_ISSUE_TITLE, STUB_PR_TITLE.

[ -n "${GH_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_LOG"

# ── Rate-limit simulation hook (#173) ─────────────────────────────────────────
# GH_RATE_LIMIT_UNTIL_CALL=<N>: the first N invocations of this stub (across
# the whole test, or since GH_RATE_LIMIT_COUNTER_FILE was last removed) print
# a gh-CLI-style rate-limit error to stderr and exit 1; the (N+1)th and later
# invocations fall through to the normal canned response below. Modeled on
# CURL_QUEUE's pop-one-line-per-call pattern, but needs a persistent counter
# (not a queue) since each invocation is a separate process. Counter file
# defaults to "$GH_LOG.rlcount" (override with GH_RATE_LIMIT_COUNTER_FILE);
# tests should `rm -f` it before use so counts from earlier assertions in the
# same file don't bleed in.
if [ -n "${GH_RATE_LIMIT_UNTIL_CALL:-}" ]; then
  _rl_counter="${GH_RATE_LIMIT_COUNTER_FILE:-${GH_LOG:-/tmp/gh-stub-no-log}.rlcount}"
  _rl_count=0
  [ -f "$_rl_counter" ] && _rl_count="$(cat "$_rl_counter")"
  _rl_count=$((_rl_count + 1))
  printf '%s' "$_rl_count" > "$_rl_counter"
  if [ "$_rl_count" -le "$GH_RATE_LIMIT_UNTIL_CALL" ]; then
    echo "gh: API rate limit exceeded for installation ID 1. (HTTP 403)" >&2
    exit 1
  fi
fi

# GH_FAIL_STDERR: when set, every invocation of this stub prints the given
# text to stderr and exits 1, unconditionally (#194). Used to prove a
# non-rate-limit error whose text happens to contain a bare "429" (e.g. an
# issue/PR number) is not misclassified as retryable by _with_retry.
if [ -n "${GH_FAIL_STDERR:-}" ]; then
  printf '%s\n' "$GH_FAIL_STDERR" >&2
  exit 1
fi

REPO="${STUB_REPO:-acme/widget}"
OWNER="${REPO%%/*}"

# ── `gh api -i ...`: the GitHub REST client's own call shape ──────────────────
# pipeline-vcs.sh sends every GitHub request as
#   gh api -i -X <METHOD> -H <header> [-H <header> --input <file>] <path>
# and reads the status line, the headers and the body back. The curl stub is
# already a fake GitHub (queued responses, comment store, assignees, identity),
# so this arm turns the call into the curl call the token transport would have
# made and prints curl's answer the way `gh api -i` does: the same stubbed
# GitHub serves both transports, which is what lets one test drive either.
#   GH_QUEUE / GH_LINK_QUEUE    the responses to pop, one per call (the curl
#                               stub's CURL_QUEUE / CURL_LINK_QUEUE format)
#   GH_REST_LOG                 one "<url> TAB <payload> TAB TAB <method>" per call,
#                               the line the curl stub writes to CURL_LOG
#   With no queue entry left, gh-rest-fixtures.py answers from the STUB_*
#   variables. A status >= 400 exits 1 with `gh: <message> (HTTP <n>)` on stderr
#   after the headers and body, as the real CLI does.
if [ "${1:-}" = api ] && [ "${2:-}" = "-i" ]; then
  shift 2
  _rm="GET"; _rin=""; _rpath=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -X) _rm="$2"; shift 2 ;;
      -H) shift 2 ;;
      --input) _rin="$2"; shift 2 ;;
      *) _rpath="$1"; shift ;;
    esac
  done
  _rpath="${_rpath//\{owner\}\/\{repo\}/$REPO}"
  _rhdr="$(mktemp)" || exit 1
  _rdir="$(dirname "$0")"
  set -- -sS -w '\n%{http_code}' -D "$_rhdr" -X "$_rm" "https://api.github.com/$_rpath"
  if [ -n "$_rin" ]; then
    set -- "${@:1:$(($# - 1))}" --data-binary @- "${@:$#}"
    _rout="$(env CURL_LOG="${GH_REST_LOG:-/dev/null}" CURL_QUEUE="${GH_QUEUE:-}" CURL_LINK_QUEUE="${GH_LINK_QUEUE:-}" \
      STUB_GH_FIXTURES=1 "$_rdir/curl" "$@" < "$_rin")"
  else
    _rout="$(env CURL_LOG="${GH_REST_LOG:-/dev/null}" CURL_QUEUE="${GH_QUEUE:-}" CURL_LINK_QUEUE="${GH_LINK_QUEUE:-}" \
      STUB_GH_FIXTURES=1 "$_rdir/curl" "$@")"
  fi
  _rstatus="${_rout##*$'\n'}"
  _rbody="${_rout%$'\n'*}"
  printf 'HTTP/2.0 %s Stub\n' "$_rstatus"
  sed 1d "$_rhdr"
  printf '%s\n' "$_rbody"
  rm -f "$_rhdr"
  if [ "$_rstatus" -ge 400 ] 2>/dev/null; then
    echo "gh: $(printf '%s' "$_rbody" | python3 -I -c 'import json,sys
try: print(json.load(sys.stdin).get("message","error"))
except Exception: print("error")') (HTTP $_rstatus)" >&2
    exit 1
  fi
  exit 0
fi

# _stub_limit <args...> — prints the value following a "--limit" argument, or
# nothing if none was passed. Used so "issue list"/"pr list" can honor
# --limit faithfully (#171) instead of always returning the full canned list.
_stub_limit() {
  local prev=""
  for a in "$@"; do
    if [ "$prev" = "--limit" ]; then
      printf '%s' "$a"
      return 0
    fi
    prev="$a"
  done
}

# Assignee state (#560). _as_path <issue-n>: the file holding that issue's
# assignees (STUB_ASSIGNEE_DIR/<n> when set, else the one STUB_ASSIGNEE_FILE).
# _as_add <file> <login>: add a login once (case-insensitive).
_as_path() {
  if [ -n "${STUB_ASSIGNEE_DIR:-}" ]; then printf '%s/%s' "$STUB_ASSIGNEE_DIR" "$1"
  else printf '%s' "${STUB_ASSIGNEE_FILE:-}"; fi
}
_as_add() {
  grep -qixF -- "$2" "$1" 2>/dev/null || printf '%s\n' "$2" >> "$1"
}

args="$*"
case "$args" in
  "repo view --json nameWithOwner -q .nameWithOwner"*)
    printf '%s\n' "$REPO" ;;
  "repo view --json url -q .url"*)
    printf 'https://github.com/%s\n' "$REPO" ;;
  "repo view --json owner -q .owner.login"*)
    printf '%s\n' "$OWNER" ;;
  "repo view --json defaultBranchRef"*)
    printf 'main\n' ;;
  "issue view "*"--json state -q .state"*)
    printf '%s\n' "${STUB_ISSUE_STATE:-OPEN}" ;;
  "pr view "*"--json state -q .state"*)
    printf '%s\n' "${STUB_PR_STATE:-OPEN}" ;;
  "pr view "*"--json mergeable -q .mergeable"*)
    # Used by pr-mergeable (#214). Override STUB_PR_MERGEABLE (default
    # MERGEABLE), or supply STUB_PR_MERGEABLE_QUEUE -- a file, one value
    # popped per call, same pattern as CURL_QUEUE -- to simulate GitHub's
    # lazy UNKNOWN -> settled transition across retries.
    if [ -n "${STUB_PR_MERGEABLE_QUEUE:-}" ] && [ -s "$STUB_PR_MERGEABLE_QUEUE" ]; then
      _mg="$(head -1 "$STUB_PR_MERGEABLE_QUEUE")"
      tail -n +2 "$STUB_PR_MERGEABLE_QUEUE" > "$STUB_PR_MERGEABLE_QUEUE.tmp" \
        && mv "$STUB_PR_MERGEABLE_QUEUE.tmp" "$STUB_PR_MERGEABLE_QUEUE"
    else
      _mg="${STUB_PR_MERGEABLE:-MERGEABLE}"
    fi
    printf '%s\n' "$_mg" ;;
  "issue view "*"--json title -q .title"*)
    printf '%s\n' "${STUB_ISSUE_TITLE:-Fix login crash}" ;;
  "pr view "*"--json title -q .title"*)
    printf '%s\n' "${STUB_PR_TITLE:-fix: guard null session}" ;;
  "pr view "*"--json number,title,headRefName,labels,url,body"*)
    # Used by view-pr. Override STUB_PR_HEAD_REF_NAME -- unset (not just
    # empty) falls back to "pr-branch"; explicitly set to "" to simulate an
    # unresolvable head ref.
    printf '{"number":9,"title":"%s","headRefName":"%s","labels":[],"url":"https://github.com/%s/pull/9","body":""}\n' \
      "${STUB_PR_TITLE:-fix: guard null session}" "${STUB_PR_HEAD_REF_NAME-pr-branch}" "$REPO" ;;
  "pr view "*"--json number,body"*)
    # Used by check-closing-keyword: return PR number and body.
    # Override STUB_PR_NUMBER, STUB_PR_BODY.
    # NOTE: must come BEFORE broader patterns — bash case matches first.
    _pn="${STUB_PR_NUMBER:-9}"
    _pb="${STUB_PR_BODY:-Closes #42}"
    printf '{"number":%s,"body":"%s"}\n' "$_pn" "$_pb" ;;
  "pr view "*"--json headRefOid,baseRefName,labels,comments"*)
    # Used by check-approval-sha: return a combined PR object.
    # Override STUB_PR_HEAD_SHA, STUB_PR_BASE_REF_NAME, STUB_PR_LABELS_JSON, STUB_PR_COMMENTS_JSON.
    # NOTE: must come BEFORE the plain headRefOid pattern — bash case matches first.
    _sha="${STUB_PR_HEAD_SHA:-abc123sha}"
    _base="${STUB_PR_BASE_REF_NAME:-main}"
    _labels="${STUB_PR_LABELS_JSON:-[]}"
    _comments="${STUB_PR_COMMENTS_JSON:-[]}"
    printf '{"headRefOid":"%s","baseRefName":"%s","labels":%s,"comments":%s}\n' \
      "$_sha" "$_base" "$_labels" "$_comments" ;;
  "pr view "*"--json headRefOid,comments"*)
    # Used by label-pr post-dispatch warning (#115): headRefOid + comments only.
    # Override STUB_PR_HEAD_SHA, STUB_PR_COMMENTS_JSON.
    # NOTE: must come BEFORE the plain headRefOid pattern — bash case matches first.
    _sha="${STUB_PR_HEAD_SHA:-abc123sha}"
    _comments="${STUB_PR_COMMENTS_JSON:-[]}"
    printf '{"headRefOid":"%s","comments":%s}\n' "$_sha" "$_comments" ;;
  "pr view "*"--json headRefOid"*)
    printf '%s\n' "${STUB_PR_HEAD_SHA:-abc123sha}" ;;
  "pr view "*"--json files"*)
    # One path per line (script passes -q '.files[].path')
    printf '%s\n' "${STUB_PR_FILES:-src/auth.js
tests/auth.test.js}" ;;
  "pr list --state "*)
    # NB: JSON braces can't live inside ${VAR:-default} — } ends the expansion
    if [ -n "${STUB_PR_LIST:-}" ]; then
      _pl_raw="$STUB_PR_LIST"
    else
      _pl_raw='[{"number":9,"state":"OPEN","title":"fix: guard null session","headRefName":"fix/issue-42-guard","body":"Closes #42"}]'
    fi
    # Honor --limit N faithfully (#171): a real `gh pr list --limit N`
    # truncates to at most N results, so a stub that ignores --limit would
    # make a "does list-prs paginate past the old cap" test pass even
    # against the pre-fix code. Truncate here so that test is genuinely red
    # on the old hardcoded-cap implementation.
    _limit="$(_stub_limit "$@")"
    if [ -n "$_limit" ]; then
      _pl_raw="$(printf '%s' "$_pl_raw" | LIMIT="$_limit" python3 -I -c "
import json, os, sys
d = json.load(sys.stdin)
print(json.dumps(d[:int(os.environ['LIMIT'])]))
")"
    fi
    printf '%s\n' "$_pl_raw" ;;
  "issue list --repo "*"--search "*"--state open "*"--json number,title,createdAt,author"*)
    # Used by tests/canary/run.sh's sweep_stale (#188): search-then-anchor
    # stale-issue sweep. Override STUB_CANARY_ISSUE_LIST_STALE with the
    # canned `[{"number":N,"title":"...","createdAt":"...","author":{"login":"..."}}]`
    # array; default is empty (no stale leftovers to sweep).
    printf '%s\n' "${STUB_CANARY_ISSUE_LIST_STALE:-[]}" ;;
  "pr list --repo "*"--search "*"--state open "*"--json number,title,createdAt,author"*)
    # Used by tests/canary/run.sh's sweep_stale (#188) -- see issue-list
    # case above. Override STUB_CANARY_PR_LIST_STALE.
    printf '%s\n' "${STUB_CANARY_PR_LIST_STALE:-[]}" ;;
  "issue list --state "*)
    # NB: JSON braces can't live inside ${VAR:-default} — } ends the expansion.
    # Override STUB_ISSUE_LIST to simulate a larger result set (#171).
    if [ -n "${STUB_ISSUE_LIST:-}" ]; then
      _il_raw="$STUB_ISSUE_LIST"
    else
      _il_raw='[{"number":3,"title":"Fix login bug","labels":[{"name":"pipeline:dev"}],"body":"Body text"}]'
    fi
    # Honor --limit N faithfully (#171) — see rationale on "pr list" above.
    _limit="$(_stub_limit "$@")"
    if [ -n "$_limit" ]; then
      _il_raw="$(printf '%s' "$_il_raw" | LIMIT="$_limit" python3 -I -c "
import json, os, sys
d = json.load(sys.stdin)
print(json.dumps(d[:int(os.environ['LIMIT'])]))
")"
    fi
    printf '%s\n' "$_il_raw" ;;
  "api --paginate repos/"*"/issues?state=open"*)
    # Simulates `gh api --paginate` for the REST issues endpoint (#171): pages
    # are streamed back-to-back with NO separator and no merging (per gh's
    # own --help text) — override STUB_GH_ISSUES_RAW with pre-concatenated
    # page JSON to exercise the multi-page merge in pipeline-vcs.sh. Set
    # STUB_GH_API_FAIL=issues to simulate a failed page (non-zero exit, no
    # stdout), mirroring how a real failed request never prints partial JSON.
    if [ "${STUB_GH_API_FAIL:-}" = "issues" ]; then
      exit 1
    fi
    if [ -n "${STUB_GH_ISSUES_RAW:-}" ]; then
      printf '%s' "$STUB_GH_ISSUES_RAW"
    else
      printf '[{"number":3,"title":"Fix login bug","labels":[{"name":"pipeline:dev"}],"body":"Body text"}]'
    fi ;;
  "api --paginate repos/"*"/pulls?state=open"*)
    # Simulates `gh api --paginate` for the REST pulls endpoint (#171); see
    # the issues variant above for the page-concatenation rationale.
    # STUB_GH_API_FAIL=prs simulates a failed page. With STUB_GH_PRS_RAW
    # unset, a set STUB_PR_LIST (the `pr list` fixture) is served in REST
    # shape, so check-closing-keyword's sibling fetch (#319) reads the same
    # fixture it read through `gh pr list`.
    if [ "${STUB_GH_API_FAIL:-}" = "prs" ]; then
      echo "gh: HTTP 502: Bad Gateway (https://api.github.com/repos/$REPO/pulls?page=2)" >&2
      exit 1
    fi
    if [ -n "${STUB_GH_PRS_RAW:-}" ]; then
      printf '%s' "$STUB_GH_PRS_RAW"
    elif [ -n "${STUB_PR_LIST:-}" ]; then
      printf '%s' "$STUB_PR_LIST" | python3 -I -c "
import json, sys
print(json.dumps([{'number': p.get('number'), 'state': str(p.get('state', 'OPEN')).lower(),
                   'title': p.get('title', ''), 'head': {'ref': p.get('headRefName', '')},
                   'body': p.get('body', '')} for p in json.load(sys.stdin)]))"
    else
      printf '[{"number":9,"title":"fix: guard null session","head":{"ref":"fix/issue-42-guard"},"base":{"ref":"main"},"labels":[]}]'
    fi ;;
  "api --paginate repos/"*"/pulls/"*"/files"*)
    # Simulates `gh api --paginate` for the REST PR-files endpoint (#211
    # review fix -- pr-files now paginates instead of a single `gh pr view
    # --json files` call capped at 100 entries). Pages stream back-to-back
    # with NO separator, same convention as the issues/pulls endpoints above.
    # STUB_GH_API_FAIL=pr-files simulates a failed page (non-zero exit, no
    # stdout). Override STUB_GH_PR_FILES_RAW with pre-concatenated page JSON
    # to exercise the multi-page merge (e.g. >100 files); otherwise falls
    # back to converting STUB_PR_FILES (newline-separated paths -- back-compat
    # with the pre-#211 `gh pr view --json files` stub contract) into a
    # single-page filename array.
    if [ "${STUB_GH_API_FAIL:-}" = "pr-files" ]; then
      exit 1
    fi
    if [ -n "${STUB_GH_PR_FILES_RAW:-}" ]; then
      printf '%s' "$STUB_GH_PR_FILES_RAW"
    else
      FILES="${STUB_PR_FILES:-src/auth.js
tests/auth.test.js}" python3 -I -c "
import json, os
paths = [p for p in os.environ['FILES'].splitlines() if p]
print(json.dumps([{'filename': p} for p in paths]))
"
    fi ;;
  "api user --jq .login"*)
    # Used by _vcs_shared_current_user (#187) to infer the authenticated
    # login as trusted for approval-marker/attempt-marker author checks.
    # Override STUB_CURRENT_USER; empty (default) simulates an unresolved
    # identity -- same as any other unmatched command falling to the
    # catch-all -- so every pre-#187 test keeps its unconfigured/fail-open
    # behaviour without needing to set this.
    # STUB_CURRENT_USER_FAIL=1 (#381) is GET /user refused (an Actions
    # GITHUB_TOKEN, a GitHub App token): like the real `gh api --jq`, the raw
    # error JSON goes to STDOUT (the filter is not applied) and the exit is 1.
    if [ "${STUB_CURRENT_USER_FAIL:-}" = "1" ]; then
      printf '%s\n' '{"message":"Resource not accessible by integration","documentation_url":"https://docs.github.com/rest","status":"403"}'
      echo "gh: Resource not accessible by integration (HTTP 403)" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_CURRENT_USER:-}" ;;
  "api --method POST repos/"*"/comments --input -"|"api --method PATCH repos/"*"/issues/comments/"*" --input -")
    # upsert-pr-comment's writes (#381): the JSON body arrives on STDIN
    # (`--input -`), never argv. Each attempt's stdin is appended, one line, to
    # $GH_STDIN_LOG when set -- an empty line there means a retry re-sent an
    # empty body. STUB_COMMENT_WRITE_429=<N>: the first N writes fail with a
    # rate limit (retryable); STUB_COMMENT_WRITE_FAIL=1: every write fails.
    # With STUB_COMMENT_STORE (a JSON array file, see the comments arm below)
    # a POST appends a comment by $STUB_CURRENT_USER and a PATCH edits one in
    # place; either prints the comment. Without it the write is silent, as the
    # catch-all below always was.
    _cw_payload="$(mktemp)" || exit 1
    cat > "$_cw_payload"
    [ -n "${GH_STDIN_LOG:-}" ] && { cat "$_cw_payload"; printf '\n'; } >> "$GH_STDIN_LOG"
    if [ -n "${STUB_COMMENT_WRITE_429:-}" ]; then
      # The counter lives next to the log, so parallel tests (each with its own
      # sandbox log) never share state; without a log there is nowhere safe.
      if [ -z "${GH_LOG:-}" ]; then
        echo "gh stub: STUB_COMMENT_WRITE_429 needs GH_LOG set" >&2
        exit 1
      fi
      _cw_counter="$GH_LOG.w429"
      _cw_count=0
      [ -f "$_cw_counter" ] && _cw_count="$(cat "$_cw_counter")"
      _cw_count=$((_cw_count + 1))
      printf '%s' "$_cw_count" > "$_cw_counter"
      if [ "$_cw_count" -le "$STUB_COMMENT_WRITE_429" ]; then
        rm -f "$_cw_payload"
        echo "gh: HTTP 429: API rate limit exceeded" >&2
        exit 1
      fi
    fi
    if [ "${STUB_COMMENT_WRITE_FAIL:-}" = "1" ]; then
      rm -f "$_cw_payload"
      echo "gh: HTTP 500: Server Error" >&2
      exit 1
    fi
    if [ -n "${STUB_COMMENT_STORE:-}" ] && [ -e "$STUB_COMMENT_STORE" ]; then
      python3 -I -c "
import json, os, sys
store, op, target, pfile, user, repo = sys.argv[1:7]
items = json.load(open(store)) if os.path.getsize(store) else []
body = json.load(open(pfile))['body']
if op == 'POST':
    n = target.split('/issues/')[1].split('/')[0]
    nid = max([c['id'] for c in items] + [5000]) + 1
    c = {'id': nid, 'user': {'login': user}, 'body': body,
         'created_at': '2026-10-03T00:%02d:00Z' % (len(items) % 60),
         'html_url': 'https://github.com/%s/pull/%s#issuecomment-%d' % (repo, n, nid)}
    items.append(c)
else:
    cid = int(target.rsplit('/', 1)[1])
    c = next(x for x in items if x['id'] == cid)
    c['body'] = body
json.dump(items, open(store, 'w'))
print(json.dumps(c))
" "$STUB_COMMENT_STORE" "$3" "$4" "$_cw_payload" "${STUB_CURRENT_USER:-}" "$REPO"
    fi
    rm -f "$_cw_payload" ;;
  "api --paginate repos/"*"/issues/"*"/comments"*)
    # Simulates `gh api --paginate` for the REST issue/PR comments endpoint
    # (#172 read-comments, used by read-attempt and post-approval's
    # duplicate-marker check): pages are streamed back-to-back with NO
    # separator, same as the issues/pulls list endpoints above. Override
    # STUB_GH_COMMENTS_RAW with pre-concatenated page JSON to exercise the
    # multi-page merge; falls back to STUB_ISSUE_COMMENTS_JSON (back-compat
    # with pre-#172 tests that stubbed the old `gh issue view --json comments`
    # call) then to an empty array. STUB_GH_API_FAIL=comments simulates a
    # failed page (non-zero exit, no stdout).
    if [ "${STUB_GH_API_FAIL:-}" = "comments" ]; then
      exit 1
    fi
    if [ -n "${STUB_COMMENT_STORE:-}" ] && [ -s "$STUB_COMMENT_STORE" ]; then
      # Stateful store (#381): the comments the upsert writes land here.
      cat "$STUB_COMMENT_STORE"
    elif [ -n "${STUB_GH_COMMENTS_RAW:-}" ]; then
      printf '%s' "$STUB_GH_COMMENTS_RAW"
    else
      printf '%s' "${STUB_ISSUE_COMMENTS_JSON:-[]}"
    fi ;;
  "run list --commit "*)
    printf '[{"databaseId":111,"conclusion":"failure"},{"databaseId":112,"conclusion":"success"}]\n' ;;
  "pr checks "*)
    # Used by pr-checks (#195: QA's qa_mode: ci oracle). Override
    # STUB_PR_CHECKS to supply canned `gh pr checks` output; defaults to all
    # required checks passing. STUB_PR_CHECKS_EXIT sets the exit code (a real
    # `gh pr checks` exits non-zero when any check has failed).
    printf '%s\n' "${STUB_PR_CHECKS:-test	pass	1m2s	https://example/checks}"
    exit "${STUB_PR_CHECKS_EXIT:-0}" ;;
  "issue view "*"--json assignees"*)
    # assign-issue's read / read-back (#299). STUB_ASSIGNEE_FILE holds the
    # issue's current assignee (absent or empty = unassigned), so a write
    # below is visible to the read-back that follows it. STUB_ASSIGNEE_DIR
    # (#560) keeps one file per issue number instead ($DIR/<n>, one login per
    # line), for tests with several issues.
    _as_f="$(_as_path "$3")"
    [ -n "$_as_f" ] && [ -s "$_as_f" ] && cat "$_as_f"
    exit 0 ;;
  "issue edit "*"--add-assignee "*)
    # assign-issue's write (#299). STUB_ASSIGN_FAIL=1: GitHub rejects the
    # assignee (non-zero exit, error on stderr). STUB_ASSIGN_DROP=1: exits 0
    # but the assignee never lands, so only the read-back can catch it.
    # --add-assignee ADDS (#560, with STUB_ASSIGNEE_DIR or STUB_ASSIGNEE_ADD=1):
    # the assignees already there stay. STUB_ASSIGNEE_RACER=<login> (#560):
    # another operator's write lands at the same moment, so both are on the
    # issue at the read-back.
    if [ "${STUB_ASSIGN_FAIL:-}" = "1" ]; then
      echo "failed to update https://github.com/$REPO/issues/42: could not assign user: not found" >&2
      exit 1
    fi
    _as_prev=""
    for _as_a in "$@"; do
      [ "$_as_prev" = "--add-assignee" ] && _as_login="$_as_a"
      _as_prev="$_as_a"
    done
    _as_f="$(_as_path "$3")"
    if [ "${STUB_ASSIGN_DROP:-}" != "1" ] && [ -n "$_as_f" ]; then
      if [ -n "${STUB_ASSIGNEE_DIR:-}" ] || [ "${STUB_ASSIGNEE_ADD:-}" = "1" ]; then
        _as_add "$_as_f" "$_as_login"
      else
        printf '%s\n' "$_as_login" > "$_as_f"
      fi
      [ -n "${STUB_ASSIGNEE_RACER:-}" ] && _as_add "$_as_f" "$STUB_ASSIGNEE_RACER"
    fi
    exit 0 ;;
  "issue edit "*"--remove-assignee "*)
    # unassign-issue's write (#560). STUB_UNASSIGN_FAIL=1 rejects it.
    if [ "${STUB_UNASSIGN_FAIL:-}" = "1" ]; then
      echo "failed to update https://github.com/$REPO/issues/42: could not unassign user" >&2
      exit 1
    fi
    _as_prev=""
    for _as_a in "$@"; do
      [ "$_as_prev" = "--remove-assignee" ] && _as_login="$_as_a"
      _as_prev="$_as_a"
    done
    _as_f="$(_as_path "$3")"
    if [ -n "$_as_f" ] && [ -f "$_as_f" ]; then
