#!/usr/bin/env bash
# gh stub for talos tests. Logs every invocation to $GH_LOG and returns
# canned responses for the query shapes the pipeline scripts use.
# Override values with: STUB_REPO (owner/name), STUB_ISSUE_TITLE, STUB_PR_TITLE.

[ -n "${GH_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_LOG"

# ── Rate-limit simulation hook (#173) ─────────────────────────────────────────
# GH_RATE_LIMIT_UNTIL_CALL=<N>: the first N invocations of this stub (across
# the whole test, or since GH_RATE_LIMIT_COUNTER_FILE was last removed) print
# a gh-CLI-style rate-limit error to stderr and exit 1; the (N+1)th and later
# invocations fall through to the normal canned response below. Modeled on
# CURL_QUEUE's pop-one-line-per-call pattern, but needs a persistent counter
# (not a queue) since each invocation is a separate process. Counter file
# defaults to "$GH_LOG.rlcount" (override with GH_RATE_LIMIT_COUNTER_FILE);
# tests should `rm -f` it before use so counts from earlier assertions in the
# same file don't bleed in.
if [ -n "${GH_RATE_LIMIT_UNTIL_CALL:-}" ]; then
  _rl_counter="${GH_RATE_LIMIT_COUNTER_FILE:-${GH_LOG:-/tmp/gh-stub-no-log}.rlcount}"
  _rl_count=0
  [ -f "$_rl_counter" ] && _rl_count="$(cat "$_rl_counter")"
  _rl_count=$((_rl_count + 1))
  printf '%s' "$_rl_count" > "$_rl_counter"
  if [ "$_rl_count" -le "$GH_RATE_LIMIT_UNTIL_CALL" ]; then
    echo "gh: API rate limit exceeded for installation ID 1. (HTTP 403)" >&2
    exit 1
  fi
fi

# GH_FAIL_STDERR: when set, every invocation of this stub prints the given
# text to stderr and exits 1, unconditionally (#194). Used to prove a
# non-rate-limit error whose text happens to contain a bare "429" (e.g. an
# issue/PR number) is not misclassified as retryable by _with_retry.
if [ -n "${GH_FAIL_STDERR:-}" ]; then
  printf '%s\n' "$GH_FAIL_STDERR" >&2
  exit 1
fi

REPO="${STUB_REPO:-acme/widget}"
OWNER="${REPO%%/*}"

# _stub_limit <args...> — prints the value following a "--limit" argument, or
# nothing if none was passed. Used so "issue list"/"pr list" can honor
# --limit faithfully (#171) instead of always returning the full canned list.
_stub_limit() {
  local prev=""
  for a in "$@"; do
    if [ "$prev" = "--limit" ]; then
      printf '%s' "$a"
      return 0
    fi
    prev="$a"
  done
}

args="$*"
case "$args" in
  "repo view --json nameWithOwner -q .nameWithOwner"*)
    printf '%s\n' "$REPO" ;;
  "repo view --json url -q .url"*)
    printf 'https://github.com/%s\n' "$REPO" ;;
  "repo view --json owner -q .owner.login"*)
    printf '%s\n' "$OWNER" ;;
  "repo view --json defaultBranchRef"*)
    printf 'main\n' ;;
  "issue view "*"--json state -q .state"*)
    printf '%s\n' "${STUB_ISSUE_STATE:-OPEN}" ;;
  "pr view "*"--json state -q .state"*)
    printf '%s\n' "${STUB_PR_STATE:-OPEN}" ;;
  "pr view "*"--json mergeable -q .mergeable"*)
    # Used by pr-mergeable (#214). Override STUB_PR_MERGEABLE (default
    # MERGEABLE), or supply STUB_PR_MERGEABLE_QUEUE -- a file, one value
    # popped per call, same pattern as CURL_QUEUE -- to simulate GitHub's
    # lazy UNKNOWN -> settled transition across retries.
    if [ -n "${STUB_PR_MERGEABLE_QUEUE:-}" ] && [ -s "$STUB_PR_MERGEABLE_QUEUE" ]; then
      _mg="$(head -1 "$STUB_PR_MERGEABLE_QUEUE")"
      tail -n +2 "$STUB_PR_MERGEABLE_QUEUE" > "$STUB_PR_MERGEABLE_QUEUE.tmp" \
        && mv "$STUB_PR_MERGEABLE_QUEUE.tmp" "$STUB_PR_MERGEABLE_QUEUE"
    else
      _mg="${STUB_PR_MERGEABLE:-MERGEABLE}"
    fi
    printf '%s\n' "$_mg" ;;
  "issue view "*"--json title -q .title"*)
    printf '%s\n' "${STUB_ISSUE_TITLE:-Fix login crash}" ;;
  "pr view "*"--json title -q .title"*)
    printf '%s\n' "${STUB_PR_TITLE:-fix: guard null session}" ;;
  "pr view "*"--json number,body"*)
    # Used by check-closing-keyword: return PR number and body.
    # Override STUB_PR_NUMBER, STUB_PR_BODY.
    # NOTE: must come BEFORE broader patterns — bash case matches first.
    _pn="${STUB_PR_NUMBER:-9}"
    _pb="${STUB_PR_BODY:-Closes #42}"
    printf '{"number":%s,"body":"%s"}\n' "$_pn" "$_pb" ;;
  "pr view "*"--json headRefOid,baseRefName,labels,comments"*)
    # Used by check-approval-sha: return a combined PR object.
    # Override STUB_PR_HEAD_SHA, STUB_PR_BASE_REF_NAME, STUB_PR_LABELS_JSON, STUB_PR_COMMENTS_JSON.
    # NOTE: must come BEFORE the plain headRefOid pattern — bash case matches first.
    _sha="${STUB_PR_HEAD_SHA:-abc123sha}"
    _base="${STUB_PR_BASE_REF_NAME:-main}"
    _labels="${STUB_PR_LABELS_JSON:-[]}"
    _comments="${STUB_PR_COMMENTS_JSON:-[]}"
    printf '{"headRefOid":"%s","baseRefName":"%s","labels":%s,"comments":%s}\n' \
      "$_sha" "$_base" "$_labels" "$_comments" ;;
  "pr view "*"--json headRefOid,comments"*)
    # Used by label-pr post-dispatch warning (#115): headRefOid + comments only.
    # Override STUB_PR_HEAD_SHA, STUB_PR_COMMENTS_JSON.
    # NOTE: must come BEFORE the plain headRefOid pattern — bash case matches first.
    _sha="${STUB_PR_HEAD_SHA:-abc123sha}"
    _comments="${STUB_PR_COMMENTS_JSON:-[]}"
    printf '{"headRefOid":"%s","comments":%s}\n' "$_sha" "$_comments" ;;
  "pr view "*"--json headRefOid"*)
    printf '%s\n' "${STUB_PR_HEAD_SHA:-abc123sha}" ;;
  "pr view "*"--json files"*)
    # One path per line (script passes -q '.files[].path')
    printf '%s\n' "${STUB_PR_FILES:-src/auth.js
tests/auth.test.js}" ;;
  "pr list --state "*)
    # NB: JSON braces can't live inside ${VAR:-default} — } ends the expansion
    if [ -n "${STUB_PR_LIST:-}" ]; then
      _pl_raw="$STUB_PR_LIST"
    else
      _pl_raw='[{"number":9,"state":"OPEN","title":"fix: guard null session","headRefName":"fix/issue-42-guard","body":"Closes #42"}]'
    fi
    # Honor --limit N faithfully (#171): a real `gh pr list --limit N`
    # truncates to at most N results, so a stub that ignores --limit would
    # make a "does list-prs paginate past the old cap" test pass even
    # against the pre-fix code. Truncate here so that test is genuinely red
    # on the old hardcoded-cap implementation.
    _limit="$(_stub_limit "$@")"
    if [ -n "$_limit" ]; then
      _pl_raw="$(printf '%s' "$_pl_raw" | LIMIT="$_limit" python3 -c "
import json, os, sys
d = json.load(sys.stdin)
print(json.dumps(d[:int(os.environ['LIMIT'])]))
")"
    fi
    printf '%s\n' "$_pl_raw" ;;
  "issue list --state "*)
    # NB: JSON braces can't live inside ${VAR:-default} — } ends the expansion.
    # Override STUB_ISSUE_LIST to simulate a larger result set (#171).
    if [ -n "${STUB_ISSUE_LIST:-}" ]; then
      _il_raw="$STUB_ISSUE_LIST"
    else
      _il_raw='[{"number":3,"title":"Fix login bug","labels":[{"name":"pipeline:dev"}],"body":"Body text"}]'
    fi
    # Honor --limit N faithfully (#171) — see rationale on "pr list" above.
    _limit="$(_stub_limit "$@")"
    if [ -n "$_limit" ]; then
      _il_raw="$(printf '%s' "$_il_raw" | LIMIT="$_limit" python3 -c "
import json, os, sys
d = json.load(sys.stdin)
print(json.dumps(d[:int(os.environ['LIMIT'])]))
")"
    fi
    printf '%s\n' "$_il_raw" ;;
  "api --paginate repos/"*"/issues?state=open"*)
    # Simulates `gh api --paginate` for the REST issues endpoint (#171): pages
    # are streamed back-to-back with NO separator and no merging (per gh's
    # own --help text) — override STUB_GH_ISSUES_RAW with pre-concatenated
    # page JSON to exercise the multi-page merge in pipeline-vcs.sh. Set
    # STUB_GH_API_FAIL=issues to simulate a failed page (non-zero exit, no
    # stdout), mirroring how a real failed request never prints partial JSON.
    if [ "${STUB_GH_API_FAIL:-}" = "issues" ]; then
      exit 1
    fi
    if [ -n "${STUB_GH_ISSUES_RAW:-}" ]; then
      printf '%s' "$STUB_GH_ISSUES_RAW"
    else
      printf '[{"number":3,"title":"Fix login bug","labels":[{"name":"pipeline:dev"}],"body":"Body text"}]'
    fi ;;
  "api --paginate repos/"*"/pulls?state=open"*)
    # Simulates `gh api --paginate` for the REST pulls endpoint (#171); see
    # the issues variant above for the page-concatenation rationale.
    # STUB_GH_API_FAIL=prs simulates a failed page.
    if [ "${STUB_GH_API_FAIL:-}" = "prs" ]; then
      exit 1
    fi
    if [ -n "${STUB_GH_PRS_RAW:-}" ]; then
      printf '%s' "$STUB_GH_PRS_RAW"
    else
      printf '[{"number":9,"title":"fix: guard null session","head":{"ref":"fix/issue-42-guard"},"base":{"ref":"main"},"labels":[]}]'
    fi ;;
  "api --paginate repos/"*"/pulls/"*"/files"*)
    # Simulates `gh api --paginate` for the REST PR-files endpoint (#211
    # review fix -- pr-files now paginates instead of a single `gh pr view
    # --json files` call capped at 100 entries). Pages stream back-to-back
    # with NO separator, same convention as the issues/pulls endpoints above.
    # STUB_GH_API_FAIL=pr-files simulates a failed page (non-zero exit, no
    # stdout). Override STUB_GH_PR_FILES_RAW with pre-concatenated page JSON
    # to exercise the multi-page merge (e.g. >100 files); otherwise falls
    # back to converting STUB_PR_FILES (newline-separated paths -- back-compat
    # with the pre-#211 `gh pr view --json files` stub contract) into a
    # single-page filename array.
    if [ "${STUB_GH_API_FAIL:-}" = "pr-files" ]; then
      exit 1
    fi
    if [ -n "${STUB_GH_PR_FILES_RAW:-}" ]; then
      printf '%s' "$STUB_GH_PR_FILES_RAW"
    else
      FILES="${STUB_PR_FILES:-src/auth.js
tests/auth.test.js}" python3 -c "
import json, os
paths = [p for p in os.environ['FILES'].splitlines() if p]
print(json.dumps([{'filename': p} for p in paths]))
"
    fi ;;
  "api --paginate repos/"*"/issues/"*"/comments"*)
    # Simulates `gh api --paginate` for the REST issue/PR comments endpoint
    # (#172 read-comments, used by read-attempt and post-approval's
    # duplicate-marker check): pages are streamed back-to-back with NO
    # separator, same as the issues/pulls list endpoints above. Override
    # STUB_GH_COMMENTS_RAW with pre-concatenated page JSON to exercise the
    # multi-page merge; falls back to STUB_ISSUE_COMMENTS_JSON (back-compat
    # with pre-#172 tests that stubbed the old `gh issue view --json comments`
    # call) then to an empty array. STUB_GH_API_FAIL=comments simulates a
    # failed page (non-zero exit, no stdout).
    if [ "${STUB_GH_API_FAIL:-}" = "comments" ]; then
      exit 1
    fi
    if [ -n "${STUB_GH_COMMENTS_RAW:-}" ]; then
      printf '%s' "$STUB_GH_COMMENTS_RAW"
    else
      printf '%s' "${STUB_ISSUE_COMMENTS_JSON:-[]}"
    fi ;;
  "run list --commit "*)
    printf '[{"databaseId":111,"conclusion":"failure"},{"databaseId":112,"conclusion":"success"}]\n' ;;
  "pr checks "*)
    # Used by pr-checks (#195: QA's qa_mode: ci oracle). Override
    # STUB_PR_CHECKS to supply canned `gh pr checks` output; defaults to all
    # required checks passing. STUB_PR_CHECKS_EXIT sets the exit code (a real
    # `gh pr checks` exits non-zero when any check has failed).
    printf '%s\n' "${STUB_PR_CHECKS:-test	pass	1m2s	https://example/checks}"
    exit "${STUB_PR_CHECKS_EXIT:-0}" ;;
  "issue comment "*)
    printf 'https://github.com/%s/issues/comments/%s\n' "$REPO" "${STUB_COMMENT_ID:-100}" ;;
  "issue create "*)
    printf 'https://github.com/%s/issues/%s\n' "$REPO" "${STUB_NEW_ISSUE_NUMBER:-42}" ;;
  "issue view "*"--json comments"*)
    # Used by read-attempt: return an object with a comments array.
    # Override STUB_ISSUE_COMMENTS_JSON (default: empty array).
    # NOTE: must come BEFORE the generic "issue view" pattern.
    _ic="${STUB_ISSUE_COMMENTS_JSON:-[]}"
    printf '{"comments":%s}\n' "$_ic" ;;
  "issue view "*"--json body -q .body"*)
    # Used by check-epic-acceptance: return the raw issue body.
    # Override STUB_EPIC_BODY (default: no checkboxes).
    # NOTE: must come BEFORE the generic "issue view" pattern.
    printf '%s\n' "${STUB_EPIC_BODY:-No checkboxes here.}" ;;
  "issue view "*"--json title,body,labels,comments"*)
    # Used by view-issue (and has-spec, which calls it internally, #199).
    # Override STUB_ISSUE_BODY (default: "stub body"),
    # STUB_ISSUE_LABELS_JSON (default: "[]"), and STUB_ISSUE_COMMENTS_JSON
    # (default: "[]" -- same override read-attempt's "--json comments" case
    # above uses, so a test can set the fixture thread once for both plain
    # view-issue and --spec's separate read-comments fetch). Built via
    # python so a multi-line STUB_ISSUE_BODY is JSON-escaped correctly.
    # NOTE: must come BEFORE the generic "issue view" pattern.
    TITLE="${STUB_ISSUE_TITLE:-Fix login crash}" \
    BODY="${STUB_ISSUE_BODY:-stub body}" \
    LABELS_JSON="${STUB_ISSUE_LABELS_JSON:-[]}" \
    COMMENTS_JSON="${STUB_ISSUE_COMMENTS_JSON:-[]}" \
    python3 -c "
import json, os
labels = json.loads(os.environ['LABELS_JSON'])
comments = json.loads(os.environ['COMMENTS_JSON'])
print(json.dumps({'title': os.environ['TITLE'], 'body': os.environ['BODY'],
                   'labels': labels, 'comments': comments}))
" ;;
  "issue view "*"--json title,body,labels"*)
    # Used by view-issue --spec (#201): the metadata-only fetch (title/body/
    # labels, no comments field -- comments come from a separate paginated
    # read-comments call). Must come AFTER the ...,comments variant above
    # (bash `case` matches the first pattern that fits) and BEFORE the fully
    # generic "issue view" fallback.
    TITLE="${STUB_ISSUE_TITLE:-Fix login crash}" \
    BODY="${STUB_ISSUE_BODY:-stub body}" \
    LABELS_JSON="${STUB_ISSUE_LABELS_JSON:-[]}" \
    python3 -c "
import json, os
labels = json.loads(os.environ['LABELS_JSON'])
print(json.dumps({'title': os.environ['TITLE'], 'body': os.environ['BODY'],
                   'labels': labels}))
" ;;
  "issue view "*)
    printf '{"title":"%s","body":"stub body","labels":[],"comments":[]}\n' \
      "${STUB_ISSUE_TITLE:-Fix login crash}" ;;
  "project list"*)
    printf '{"projects":[{"number":7,"id":"PROJ_ID_7"}]}\n' ;;
  "project field-list"*)
    # Override STUB_BOARD_OPTIONS to supply custom options JSON (e.g. omitting "Blocked").
    if [ -n "${STUB_BOARD_OPTIONS:-}" ]; then
      printf '%s\n' "$STUB_BOARD_OPTIONS"
    else
      printf '{"fields":[{"name":"Status","id":"FIELD_ID_S","options":[{"name":"In progress","id":"OPT_INPROG"},{"name":"Done","id":"OPT_DONE"},{"name":"In review","id":"OPT_INREV"},{"name":"Blocked","id":"OPT_BLOCKED"}]}]}\n'
    fi ;;
  "project item-list"*)
    printf '{"items":[{"id":"ITEM_42","content":{"number":42}}]}\n' ;;
  "project item-add"*)
    printf '{"id":"ITEM_NEW"}\n' ;;
  *)
    # label create/edit, comments, pr edits, merges, item-edit: succeed silently
    ;;
esac
exit 0
