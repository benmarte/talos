#!/usr/bin/env bash
# glab CLI stub for talos tests — logs every invocation and returns canned
# responses for the query shapes the pipeline scripts use.
[ -n "${GH_LOG:-}" ] && printf 'GLAB %s\n' "$*" >> "$GH_LOG"
# STUB_GLAB_ARGV_LOG (#305): one line per call, each argv element in [...],
# so a test can assert the exact argument boundaries GH_LOG's "$*" loses.
if [ -n "${STUB_GLAB_ARGV_LOG:-}" ]; then
  printf '[%s] ' "$@" >> "$STUB_GLAB_ARGV_LOG"
  printf '\n' >> "$STUB_GLAB_ARGV_LOG"
fi

# _stub_flags <value-flags> <bool-flags> <args...> (#305) -- reject any flag
# the real subcommand does not define, the way cobra does ("unknown flag"),
# so a wrong flag fails here instead of passing silently. Lists are
# space-padded, e.g. " -R --repo ". A value flag's next argv element is its
# value and is skipped even when it starts with "-" (a description can).
_stub_flags() {
  local _vf="$1" _bf="$2" _skip="" _f; shift 2
  for _f in "$@"; do
    if [ -n "$_skip" ]; then _skip=""; continue; fi
    case "$_f" in
      -*)
        case "$_vf" in *" ${_f%%=*} "*) case "$_f" in *=*) ;; *) _skip=1 ;; esac; continue ;; esac
        case "$_bf" in *" $_f "*) continue ;; esac
        echo "ERROR: unknown flag: $_f" >&2
        exit 1 ;;
    esac
  done
}
# Flag sets from gitlab-org/cli docs/source/issue/{view,update,create}.md
# (Options + inherited -R/--repo, -h/--help).
_GL_VIEW_VF=" --jq -F --output -p --page -P --per-page -R --repo "
_GL_VIEW_BF=" -c --comments -s --system-logs -w --web -h --help "
_GL_UPDATE_VF=" -a --assignee --attach -d --description --description-file --due-date -l --label -m --milestone -t --title -u --unlabel -w --weight -R --repo "
_GL_UPDATE_BF=" -c --confidential --lock-discussion -p --public --unassign --unlock-discussion -h --help "
_GL_CREATE_VF=" -a --assignee --attach -d --description --description-file --due-date --epic -l --label --link-type --linked-issues --linked-mr -m --milestone --template -e --time-estimate -s --time-spent -t --title -w --weight -R --repo "
_GL_CREATE_BF=" -c --confidential --no-editor --recover --web -y --yes -h --help "

# Assignee state (#560). _as_path <issue-n>: the file holding that issue's
# assignees (STUB_ASSIGNEE_DIR/<n> when set, else the one STUB_ASSIGNEE_FILE).
# _as_add <file> <login>: add a login once.
_as_path() {
  if [ -n "${STUB_ASSIGNEE_DIR:-}" ]; then printf '%s/%s' "$STUB_ASSIGNEE_DIR" "$1"
  else printf '%s' "${STUB_ASSIGNEE_FILE:-}"; fi
}
_as_add() {
  grep -qixF -- "$2" "$1" 2>/dev/null || printf '%s\n' "$2" >> "$1"
}

# _assignee_write <n> [flags...]: the --assignee half of `issue update` and
# `mr update` (#775 shares it). Real glab --assignee semantics (#305,
# cmdutils.ParseAssignees): comma-separated and repeatable; "+u" adds to the
# current assignees, "-u"/"!u" removes, a bare "u" replaces them all, and mixing
# bare with prefixed names is an error. The state is one assignee per line in
# _as_path <n>. STUB_ASSIGN_FAIL / STUB_ASSIGN_DROP as in the gh stub. No
# --assignee (label-issue) = nothing happens.
_assignee_write() {
  local _as_n="$1" _as_vals="" _as_prev="" _as_a _as_cur="" _as_f _as_new
  for _as_a in "$@"; do
    case "$_as_prev" in -a|--assignee) _as_vals="$_as_vals,$_as_a" ;; esac
    case "$_as_a" in --assignee=*) _as_vals="$_as_vals,${_as_a#--assignee=}" ;; esac
    _as_prev="$_as_a"
  done
  [ -z "$_as_vals" ] && return 0
  if [ "${STUB_ASSIGN_FAIL:-}" = "1" ]; then
    echo "ERROR: 422 {message: {assignee_ids: [not a member]}}" >&2
    exit 1
  fi
  _as_f="$(_as_path "$_as_n")"
  [ -n "$_as_f" ] && [ -s "$_as_f" ] && _as_cur="$(cat "$_as_f")"
  _as_new="$(CUR="$_as_cur" VALS="$_as_vals" python3 -I -c "
import os, sys
cur = [u for u in os.environ['CUR'].splitlines() if u.strip()]
add, rm, rep = [], [], []
for v in os.environ['VALS'].split(','):
    if not v:
        continue
    if v[0] == '+':
        add.append(v[1:])
    elif v[0] in '-!':
        rm.append(v[1:])
    else:
        rep.append(v)
if rep and (add or rm):
    sys.exit('ERROR: --assignee: mixing relative (+,!,-) and absolute assignments is forbidden')
out = rep if rep else [u for u in cur if u not in rm] + [u for u in add if u not in cur]
print('\n'.join(out))
")" || exit 1
  if [ "${STUB_ASSIGN_DROP:-}" != "1" ] && [ -n "$_as_f" ]; then
    printf '%s\n' "$_as_new" > "$_as_f"
    # STUB_ASSIGNEE_RACER=<login> (#560): another operator's write lands at
    # the same moment, so both are on the issue at the read-back.
    [ -n "${STUB_ASSIGNEE_RACER:-}" ] && _as_add "$_as_f" "$STUB_ASSIGNEE_RACER"
  fi
  return 0
}

# Note write-back (#736). With STUB_GITLAB_STATE_DIR set, `issue note` and
# `mr note` append the note to <dir>/{issue,mr}_notes_<n> (one JSON object per
# line, authored by STUB_GITLAB_POST_AUTHOR, else STUB_CURRENT_USER) and the
# notes GET serves them after the canned pages, so record-attempt then
# read-attempt is a round trip. `mr update --label` appends to <dir>/labels_<n>
# and `mr view` shows those labels. Without it every write is a silent no-op.
_note_post() {  # <issue_notes|mr_notes> <n> <message>
  [ -n "${STUB_GITLAB_STATE_DIR:-}" ] || return 0
  local _f="$STUB_GITLAB_STATE_DIR/${1}_$2" _k
  _k=$(( $(wc -l < "$_f" 2>/dev/null || echo 0) + 1 ))
  K="$_k" MSG="$3" AUTHOR="${STUB_GITLAB_POST_AUTHOR:-${STUB_CURRENT_USER:-}}" python3 -I -c '
import json, os
k = int(os.environ["K"])
print(json.dumps({"id": k + 5000, "body": os.environ["MSG"], "system": False,
                  "author": {"username": os.environ["AUTHOR"]},
                  "created_at": "2026-10-16T00:00:%02dZ" % k}))
' >> "$_f"
  case "$1" in
    issue_notes) printf 'https://gitlab.com/acme/widget/-/issues/%s#note_%s\n' "$2" "$_k" ;;
    *)           printf 'https://gitlab.com/acme/widget/-/merge_requests/%s#note_%s\n' "$2" "$_k" ;;
  esac
}
_notes_posted() {  # <issue_notes|mr_notes> <the api path>: the posted notes as one page
  [ -n "${STUB_GITLAB_STATE_DIR:-}" ] || return 0
  local _n
  case "$1" in
    issue_notes) _n="${2#*/issues/}" ;;
    *)           _n="${2#*/merge_requests/}" ;;
  esac
  _n="${_n%%/*}"
  [ -s "$STUB_GITLAB_STATE_DIR/${1}_$_n" ] || return 0
  python3 -I -c 'import json, sys; print(json.dumps([json.loads(l) for l in sys.stdin if l.strip()]))' \
    < "$STUB_GITLAB_STATE_DIR/${1}_$_n"
}
# The value of --message/-m in the argv.
_msg_of() {
  local _prev="" _a
  for _a in "$@"; do
    case "$_prev" in --message|-m) printf '%s' "$_a"; return ;; esac
    _prev="$_a"
  done
}

args="$*"
# evidence-prune on gitlab (#817): evprune.py holds the evidence branch and the MRs.
# A refusal prints the body on stdout and `ERROR: <status> ...` on stderr, exit 1.
if [ -n "${STUB_EVPRUNE_WORLD:-}" ] && [ "${1:-}" = api ]; then
  _ep_method=GET _ep_in="" _ep_url="" _ep_prev=""
  for _a in "${@:2}"; do
    case "$_ep_prev" in
      --method) _ep_method="$_a" ;;
      --input) _ep_in="$_a" ;;
      --header) ;;
      *) case "$_a" in projects/*) _ep_url="$_a" ;; esac ;;
    esac
    _ep_prev="$_a"
  done
  case "$_ep_url" in
    */repository/branches/talos-evidence|*/repository/tree?*|*/repository/commits?*|*/merge_requests/[0-9]*|*/repository/commits)
      _ep_out="$(python3 -I "$(dirname "$0")/evprune.py" gitlab "$_ep_method" "https://gitlab.com/api/v4/$_ep_url" "$_ep_in")"
      _ep_st="$(printf '%s\n' "$_ep_out" | sed -n 1p)"
      printf '%s\n' "$_ep_out" | sed 1d
      case "$_ep_st" in 2??) exit 0 ;; esac
      echo "ERROR: $_ep_st stub refusal" >&2
      exit 1 ;;
  esac
fi
case "$args" in
  "mr create "*)
    printf 'https://gitlab.com/acme/widget/-/merge_requests/%s\n' "${STUB_NEW_MR_NUMBER:-7}" ;;
  "repo view --format="*"default_branch"*)
    printf 'main\n' ;;
  "issue create "*)
    # Real glab (#305): non-interactive create needs --title plus
    # --description (or --template / --attach), and with stdout not a TTY
    # prints only the new issue's web_url on its own line
    # (issueutils.DisplayIssue, via IOStreams.LogInfo = stdout).
    shift 2
    _stub_flags "$_GL_CREATE_VF" "$_GL_CREATE_BF" "$@"
    case " $* " in
      *" --title "*|*" -t "*|*" --title="*) ;;
      *) echo "ERROR: '--title' and '--description' (or '--template' or '--attach') required for non-interactive mode" >&2; exit 1 ;;
    esac
    case " $* " in
      *" --description "*|*" -d "*|*" --description="*|*" --description-file "*|*" --template "*|*" --attach "*) ;;
      *) echo "ERROR: '--title' and '--description' (or '--template' or '--attach') required for non-interactive mode" >&2; exit 1 ;;
    esac
    printf 'https://gitlab.com/acme/widget/-/issues/%s\n' "${STUB_NEW_ISSUE_NUMBER:-42}" ;;
  "issue view "*)
    shift 2
    _stub_flags "$_GL_VIEW_VF" "$_GL_VIEW_BF" "$@"
    _iv_n="" _iv_fmt="text" _iv_prev=""
    for _iv_a in "$@"; do
      case "$_iv_prev" in -F|--output) _iv_fmt="$_iv_a" ;; esac
      case "$_iv_a" in --output=*) _iv_fmt="${_iv_a#--output=}" ;; esac
      [ -z "$_iv_n" ] && case "$_iv_a" in *[!0-9]*|'') ;; *) _iv_n="$_iv_a" ;; esac
      _iv_prev="$_iv_a"
    done
    if [ "$_iv_fmt" != "json" ]; then
      printf '{"title":"Fix login crash","description":"stub body","labels":[]}\n'
      exit 0
    fi
    # -F/--output json prints the client-go Issue (#305 models its shape):
    # `assignees` is [{id, username, name, state, web_url}] -- one entry per
    # line of STUB_ASSIGNEE_FILE (absent or empty = unassigned, the gh
    # stub's contract, #299) -- plus the deprecated singular `assignee`.
    # check-epic-acceptance (#303): STUB_GITLAB_ISSUE_VIEW_FAIL=1 fails the
    # fetch; a set STUB_GITLAB_ISSUE_DESCRIPTION (even empty) adds the
    # issue's `description` field. Unset = no description field.
    if [ "${STUB_GITLAB_ISSUE_VIEW_FAIL:-}" = "1" ]; then
      echo "ERROR: 404 Not Found" >&2
      exit 1
    fi
    # view-issue (#735): STUB_GITLAB_ISSUE_VIEW is the raw JSON to print.
    if [ -n "${STUB_GITLAB_ISSUE_VIEW:-}" ]; then
      printf '%s\n' "$STUB_GITLAB_ISSUE_VIEW"
      exit 0
    fi
    _as_cur=""
    _as_f="$(_as_path "${_iv_n:-42}")"
    [ -n "$_as_f" ] && [ -s "$_as_f" ] && _as_cur="$(cat "$_as_f")"
    CUR="$_as_cur" IID="${_iv_n:-42}" HAS_DESC="${STUB_GITLAB_ISSUE_DESCRIPTION+1}" \
      DESC="${STUB_GITLAB_ISSUE_DESCRIPTION:-}" python3 -I -c "
import json, os
users = [u for u in os.environ['CUR'].splitlines() if u.strip()]
iid = int(os.environ['IID'])
assignees = [{'id': 100 + i, 'username': u, 'name': u.title(), 'state': 'active',
              'avatar_url': '', 'web_url': 'https://gitlab.com/' + u}
             for i, u in enumerate(users)]
d = {'id': 9000 + iid, 'iid': iid, 'project_id': 1, 'title': 'Fix login crash',
     'state': 'opened', 'assignees': assignees,
     'assignee': assignees[0] if assignees else None,
     'web_url': 'https://gitlab.com/acme/widget/-/issues/%d' % iid}
if os.environ['HAS_DESC']:
    d['description'] = os.environ['DESC']
print(json.dumps(d))
" ;;
  "issue update "*)
    # assign-issue's write (#299). Real glab --assignee semantics (#305,
    # cmdutils.ParseAssignees): comma-separated and repeatable; "+u" adds to
    # the current assignees, "-u"/"!u" removes, a bare "u" replaces them all,
    # and mixing bare with prefixed names is an error. STUB_ASSIGNEE_FILE
    # holds one assignee per line. STUB_ASSIGN_FAIL / STUB_ASSIGN_DROP as in
    # the gh stub. No --assignee (label-issue) = silent success.
    shift 2
    _stub_flags "$_GL_UPDATE_VF" "$_GL_UPDATE_BF" "$@"
    _assignee_write "$@"
    exit 0 ;;
  "api --paginate projects/"*"/repository/commits?"*)
    # list-default-commits (#800): STUB_GITLAB_COMMITS is the raw output, pages
    # back-to-back as `glab api --paginate` prints them (unset = no commits).
    if [ "${STUB_GITLAB_COMMITS_FAIL:-}" = "1" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_GITLAB_COMMITS:-[]}"
    exit 0 ;;
  "api --paginate projects/"*"/issues?"*)
    # list-regresses (#800): the issues here, the merge requests below.
    if [ "${STUB_GITLAB_REGRESS_ISSUES_FAIL:-}" = "1" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_GITLAB_REGRESS_ISSUES:-[]}"
    exit 0 ;;
  "api --paginate projects/"*"/merge_requests?scope=all"*)
    if [ "${STUB_GITLAB_REGRESS_MRS_FAIL:-}" = "1" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_GITLAB_REGRESS_MRS:-[]}"
    exit 0 ;;
  "api --paginate projects/"*"/issues/"*"/notes"*)
    # view-issue's notes (#735): STUB_GITLAB_ISSUE_NOTES is the raw output,
    # pages back-to-back as `glab api --paginate` prints them (unset = no
    # notes). STUB_GITLAB_API_FAIL=1 fails it. With STUB_GITLAB_STATE_DIR set,
    # the notes `issue note` wrote follow as one more page (#736).
    if [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_GITLAB_ISSUE_NOTES:-[]}"
    _notes_posted issue_notes "$args"
    exit 0 ;;
  "api --paginate projects/"*"/merge_requests/"*"/notes"*)
    # An MR's notes (#736). This arm must stay above the sibling-list arm
    # below: its "merge_requests?"* pattern also matches
    # ".../merge_requests/9/notes?..." (? matches one character) and would
    # serve the MR list as notes. STUB_GITLAB_MR_NOTES is the raw output, pages
    # back-to-back (unset = no notes); STUB_GITLAB_MR_NOTES_FAIL=1 or
    # STUB_GITLAB_API_FAIL=1 fails it.
    if [ "${STUB_GITLAB_MR_NOTES_FAIL:-}" = "1" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_GITLAB_MR_NOTES:-[]}"
    _notes_posted mr_notes "$args"
    exit 0 ;;
  "api --paginate projects/"*"/merge_requests?"*)
    # check-closing-keyword's sibling list (#319): STUB_GITLAB_MR_PAGES is
    # the raw output, pages back-to-back as `glab api --paginate` prints
    # them; otherwise STUB_GITLAB_MR_LIST (or the `mr list` default) is the
    # single page. STUB_GITLAB_MR_LIST_FAIL=1 or STUB_GITLAB_API_FAIL=1 fails it.
    if [ "${STUB_GITLAB_MR_LIST_FAIL:-}" = "1" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    if [ -n "${STUB_GITLAB_MR_PAGES:-}" ]; then
      printf '%s\n' "$STUB_GITLAB_MR_PAGES"
    elif [ -n "${STUB_GITLAB_MR_LIST:-}" ]; then
      printf '%s\n' "$STUB_GITLAB_MR_LIST"
    else
      printf '[{"iid":7,"title":"fix: guard","state":"opened","source_branch":"fix/issue-42-guard"}]\n'
    fi
    exit 0 ;;
  "api projects/"*"/repository/branches/"*)
    # attach-files on gitlab (#810): the evidence branch exists when
    # $STUB_GITLAB_STATE_DIR/ev_branch does; `ev_files` lists its paths, one per line.
    if [ -n "${STUB_GITLAB_STATE_DIR:-}" ] && [ -f "$STUB_GITLAB_STATE_DIR/ev_branch" ]; then
      printf '{"name":"talos-evidence","commit":{"id":"%s"}}\n' "$(cat "$STUB_GITLAB_STATE_DIR/ev_branch")"
      exit 0
    fi
    echo "ERROR: 404 Branch Not Found" >&2
    exit 1 ;;
  "api projects/"*"/repository/tree?"*)
    # The files under ?path= on the evidence branch, as the tree API lists them.
    [ -n "${STUB_GITLAB_STATE_DIR:-}" ] && [ -f "$STUB_GITLAB_STATE_DIR/ev_files" ] || { printf '[]\n'; exit 0; }
    _tp="${args#*path=}"; _tp="${_tp%%&*}"
    DIR_PATH="$_tp" FILES="$STUB_GITLAB_STATE_DIR/ev_files" python3 -I -c '
import json, os
d = os.environ["DIR_PATH"].rstrip("/") + "/"
print(json.dumps([{"name": f[len(d):], "type": "blob", "path": f} for f in open(os.environ["FILES"]).read().split() if f.startswith(d)]))
'
    exit 0 ;;
  "api --method POST projects/"*"/repository/commits"*)
    # attach-files on gitlab (#810): the --input file is the commit's JSON. It is
    # logged to GH_LOG as `GLAB COMMIT: <json>`; with STUB_GITLAB_STATE_DIR set it is
    # applied to the evidence branch: `start_branch` is refused for a branch that
    # exists and required for one that does not, `create` of an existing path and
    # `update` of a missing one are refused, as GitLab does.
    # STUB_GITLAB_COMMIT_FAIL=<text> refuses every commit with that error.
    _in=""; _p=""
    for _a in "$@"; do
      [ "$_p" = "--input" ] && _in="$_a"
      _p="$_a"
    done
    [ -f "$_in" ] || { echo "ERROR: no --input" >&2; exit 1; }
    [ -n "${GH_LOG:-}" ] && { printf 'GLAB COMMIT: '; cat "$_in"; printf '\n'; } >> "$GH_LOG"
    if [ -n "${STUB_GITLAB_COMMIT_FAIL:-}" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "${STUB_GITLAB_COMMIT_FAIL:-ERROR: 500 Internal Server Error}" >&2
      exit 1
    fi
    [ -n "${STUB_GITLAB_STATE_DIR:-}" ] || { printf '{"id":"cccc"}\n'; exit 0; }
    IN="$_in" DIR="$STUB_GITLAB_STATE_DIR" python3 -I -c '
import json, os, sys
d = json.load(open(os.environ["IN"]))
bf, ff = os.path.join(os.environ["DIR"], "ev_branch"), os.path.join(os.environ["DIR"], "ev_files")
exists = os.path.exists(bf)
files = open(ff).read().split() if os.path.exists(ff) else []
def refuse(msg):
    sys.stderr.write("ERROR: 400 Bad Request: " + msg + "\n")
    sys.exit(1)
if exists and d.get("start_branch"):
    refuse("A branch called talos-evidence already exists")
if not exists and not d.get("start_branch"):
    refuse("You can only create or edit files when you are on a branch")
for a in d["actions"]:
    if a["encoding"] != "base64":
        refuse("encoding must be base64")
    if a["action"] == "create" and a["file_path"] in files:
        refuse("A file with this name already exists")
    if a["action"] == "update" and a["file_path"] not in files:
        refuse("A file with this name doesnt exist")
files += [a["file_path"] for a in d["actions"] if a["action"] == "create"]
open(ff, "w").write("\n".join(files) + "\n")
open(bf, "w").write("cccc")
print(json.dumps({"id": "cccc"}))
'
    exit $? ;;
  "api --method POST projects/"*"/uploads"*)
    # attach-files on gitlab (#776): --input is the multipart body of one file
    # (--header carries its Content-Type). The call is logged to GH_LOG as
    # `GLAB UPLOAD: <name> <bytes> <content-type>`; with STUB_UPLOAD_DIR the file's
    # bytes are copied to <dir>/<name>. The answer carries the markdown GitLab
    # builds: an image link for an image, a plain link otherwise.
    # STUB_GITLAB_UPLOAD_FAIL=<text> fails an upload whose name contains <text>;
    # STUB_GITLAB_API_FAIL=1 fails every one. STUB_GITLAB_UPLOAD_MESSAGE is the
    # error text a failed upload prints on stderr (#811).
    _in=""; _ct=""; _p=""
    for _a in "$@"; do
      [ "$_p" = "--input" ] && _in="$_a"
      [ "$_p" = "--header" ] && _ct="${_a#Content-Type: }"
      _p="$_a"
    done
    [ -f "$_in" ] || { echo "ERROR: no --input" >&2; exit 1; }
    _up="$(IN="$_in" OUT="${STUB_UPLOAD_DIR:-}" python3 -I -c '
import os, re
raw = open(os.environ["IN"], "rb").read()
m = re.search(rb"filename=\"([^\"]*)\"", raw)
name = m.group(1).decode() if m else ""
head, _, rest = raw.partition(b"\r\n\r\n")
body = rest.rsplit(b"\r\n--", 1)[0]
if os.environ["OUT"] and name:
    open(os.path.join(os.environ["OUT"], name), "wb").write(body)
print(name, len(body))
')"
    _un="${_up% *}"
    if [ "${STUB_GITLAB_API_FAIL:-}" = "1" ] || { [ -n "${STUB_GITLAB_UPLOAD_FAIL:-}" ] && [[ "$_un" == *"$STUB_GITLAB_UPLOAD_FAIL"* ]]; }; then
      echo "${STUB_GITLAB_UPLOAD_MESSAGE:-ERROR: 500 Internal Server Error}" >&2
      exit 1
    fi
    [ -n "${GH_LOG:-}" ] && printf 'GLAB UPLOAD: %s %s\n' "$_up" "$_ct" >> "$GH_LOG"
    case "$_un" in
      *.png|*.jpg|*.jpeg|*.gif|*.webp) _bang='!' ;;
      *) _bang='' ;;
    esac
    printf '{"alt":"%s","url":"/uploads/0123abcd/%s","full_path":"/-/project/1/uploads/0123abcd/%s","markdown":"%s[%s](/uploads/0123abcd/%s)"}\n' "$_un" "$_un" "$_un" "$_bang" "$_un" "$_un"
    exit 0 ;;
  "api --method POST projects/"*"/merge_requests/"*"/notes"*)
    # upsert-pr-comment's create (#763): the --input file is {"body": ...}. It
    # is logged to GH_LOG as `GLAB BODY: ...` and, with STUB_GITLAB_STATE_DIR
    # set, recorded as an MR note. STUB_GITLAB_NOTE_WRITE_FAIL=1 or
    # STUB_GITLAB_API_FAIL=1 fails the write.
    if [ "${STUB_GITLAB_NOTE_WRITE_FAIL:-}" = "1" ] || [ "${STUB_GITLAB_API_FAIL:-}" = "1" ]; then
      echo "ERROR: 500 Internal Server Error" >&2
      exit 1
    fi
    _in=""; _p=""
    for _a in "$@"; do
      [ "$_p" = "--input" ] && _in="$_a"
      _p="$_a"
    done
