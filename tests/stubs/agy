#!/usr/bin/env bash
# agy CLI stub for talos tests. Same logging contract as the gemini stub.
{
  printf 'AGY ARGS:'; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'
} >> "${RUNNER_LOG:-/dev/null}"
# Failover tests (#418), all default-off: STUB_AGY_HOOK is eval'd (a stage
# that writes before dying), _STDERR / _STDOUT replace the output, _EXIT is the
# exit code, STUB_PROMPT_DIR keeps the last argv element (the prompt) per runner.
[ -z "${STUB_PROMPT_DIR:-}" ] || printf '%s' "${@: -1}" > "$STUB_PROMPT_DIR/agy.prompt"
[ -z "${STUB_AGY_HOOK:-}" ] || eval "$STUB_AGY_HOOK"
[ -z "${STUB_AGY_STDERR:-}" ] || printf '%s\n' "$STUB_AGY_STDERR" >&2
echo "${STUB_AGY_STDOUT:-agy-stub-ok}"
exit "${STUB_AGY_EXIT:-0}"
