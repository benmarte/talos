#!/usr/bin/env bash
# gemini CLI stub for talos tests. Same logging contract as the codex stub.
{
  printf 'GEMINI ARGS:'; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'
} >> "${RUNNER_LOG:-/dev/null}"
# Failover tests (#418), all default-off: STUB_GEMINI_HOOK is eval'd (a stage
# that writes before dying), _STDERR / _STDOUT replace the output, _EXIT is the
# exit code, STUB_PROMPT_DIR keeps the last argv element (the prompt) per runner.
[ -z "${STUB_PROMPT_DIR:-}" ] || printf '%s' "${@: -1}" > "$STUB_PROMPT_DIR/gemini.prompt"
[ -z "${STUB_GEMINI_HOOK:-}" ] || eval "$STUB_GEMINI_HOOK"
[ -z "${STUB_GEMINI_STDERR:-}" ] || printf '%s\n' "$STUB_GEMINI_STDERR" >&2
echo "${STUB_GEMINI_STDOUT:-gemini-stub-ok}"
exit "${STUB_GEMINI_EXIT:-0}"
