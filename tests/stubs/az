#!/usr/bin/env bash
# az CLI stub for talos tests — logs every invocation and returns canned
# responses for the query shapes the _azure adapter uses.
# Log each argument in brackets so argv boundaries are visible in assertions.
if [ -n "${GH_LOG:-}" ]; then
  printf 'AZ ARGS:' >> "$GH_LOG"
  for _a in "$@"; do printf ' [%s]' "$_a" >> "$GH_LOG"; done
  printf '\n' >> "$GH_LOG"
fi

args="$*"
# Assignee state (#560). _as_path <work-item-id>: the file holding that work
# item's assignee (STUB_ASSIGNEE_DIR/<id> when set, else the one
# STUB_ASSIGNEE_FILE). ADO has a single System.AssignedTo.
_as_path() {
  if [ -n "${STUB_ASSIGNEE_DIR:-}" ]; then printf '%s/%s' "$STUB_ASSIGNEE_DIR" "$1"
  else printf '%s' "${STUB_ASSIGNEE_FILE:-}"; fi
}
# _as_id <args...>: the value after --id.
_as_id() {
  local _p="" _a
  for _a in "$@"; do
    [ "$_p" = "--id" ] && { printf '%s' "$_a"; return 0; }
    _p="$_a"
  done
}


# When AZ_STUB_NO_EXT=1, extension list returns nothing (simulate missing extension)
if [ "${AZ_STUB_NO_EXT:-0}" = "1" ]; then
  case "$args" in
    "extension list "*)
      exit 0 ;;  # empty output — grep for azure-devops will fail
  esac
fi

# Gate verbs (#304): env-driven responses. Each arm answers only when its
# variable is set and otherwise falls through to the responses below, so
# every older response is unchanged.
_stub_fail() { echo "ERROR: $1" >&2; exit 1; }
case "$args" in
  "rest "*"/pullRequests/"*"/iterations/"*"/changes"*)
    # pr-files: STUB_AZURE_PR_CHANGES_SKIP_<n> answers the page at $skip=<n>,
    # STUB_AZURE_PR_CHANGES any page.
    [ "${STUB_AZURE_PR_CHANGES_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    _skip="${args##*\$skip=}"; _skip="${_skip%%[!0-9]*}"
    _page_var="STUB_AZURE_PR_CHANGES_SKIP_${_skip:-0}"
    if [ -n "${!_page_var:-}" ]; then printf '%s\n' "${!_page_var}"; exit 0; fi
    if [ -n "${STUB_AZURE_PR_CHANGES:-}" ]; then printf '%s\n' "$STUB_AZURE_PR_CHANGES"; exit 0; fi ;;
  "rest "*"/commits?"*)
    # list-default-commits (#800): STUB_AZURE_COMMITS is the {"value": [...]} page at
    # searchCriteria.$skip=0 (later pages are empty); STUB_AZURE_COMMITS_FULL=1 answers
    # every page with searchCriteria.$top commits (a history that never ends).
    [ "${STUB_AZURE_COMMITS_FAIL:-}" = "1" ] && _stub_fail "TF401019: The Git repository does not exist."
    _skip="${args##*searchCriteria.\$skip=}"; _skip="${_skip%%[!0-9]*}"
    _top="${args##*searchCriteria.\$top=}"; _top="${_top%%[!0-9]*}"
    if [ "${STUB_AZURE_COMMITS_FULL:-}" = "1" ]; then
      python3 -I -c '
import json, sys
skip, top = int(sys.argv[1] or 0), int(sys.argv[2] or 1)
print(json.dumps({"value": [{"commitId": "%040d" % (skip + i), "comment": "chore: c%d" % (skip + i),
                             "committer": {"date": "2026-10-14T10:00:00Z"}} for i in range(top)]}))
' "${_skip:-0}" "${_top:-1}"
      exit 0
    fi
    if [ "${_skip:-0}" = "0" ] && [ -n "${STUB_AZURE_COMMITS:-}" ]; then printf '%s\n' "$STUB_AZURE_COMMITS"; exit 0; fi
    printf '{"value": []}\n'; exit 0 ;;
  "boards query "*)
    [ "${STUB_AZURE_WORKITEM_LIST_FAIL:-}" = "1" ] && _stub_fail "TF400813: The user is not authorized to access this resource." ;;
  "rest "*"/pullRequests/"*"/iterations?"*)
    [ "${STUB_AZURE_PR_ITERATIONS_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    if [ -n "${STUB_AZURE_PR_ITERATIONS:-}" ]; then printf '%s\n' "$STUB_AZURE_PR_ITERATIONS"; exit 0; fi ;;
  "rest --method patch "*"/_apis/wit/workitems/"*)
    # label-issue's json-patch (#783): STUB_AZURE_WI_PATCH_FAIL=1 makes it fail.
    # Otherwise fall through to the generic `rest` arm below.
    [ "${STUB_AZURE_WI_PATCH_FAIL:-}" = "1" ] && _stub_fail "TF401232: Work item 5 does not exist, or you do not have permissions to read it."
    ;;
  "rest --method patch "*"/_apis/policy/evaluations/"*)
    # pr-checks-required requeue (#764): STUB_AZURE_REQUEUE_FAIL=1 makes it fail.
    [ "${STUB_AZURE_REQUEUE_FAIL:-}" = "1" ] && _stub_fail "TF401027: You need the Policy 'Manage' permission."
    printf '{}\n'; exit 0 ;;
  "rest "*"/_apis/policy/evaluations?"*)
    # pr-checks-required (#328): STUB_AZURE_PR_EVALUATIONS is the raw REST
    # body ({"count": n, "value": [records...]}).
    [ "${STUB_AZURE_PR_EVALUATIONS_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    if [ -n "${STUB_AZURE_PR_EVALUATIONS:-}" ]; then printf '%s\n' "$STUB_AZURE_PR_EVALUATIONS"; exit 0; fi ;;
  "repos pr work-item list "*)
    [ "${STUB_AZURE_PR_WORKITEMS_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    if [ -n "${STUB_AZURE_PR_WORKITEMS:-}" ]; then printf '%s\n' "$STUB_AZURE_PR_WORKITEMS"; exit 0; fi ;;
  "repos pr policy list "*)
    [ "${STUB_AZURE_PR_POLICIES_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    if [ -n "${STUB_AZURE_PR_POLICIES:-}" ]; then printf '%s\n' "$STUB_AZURE_PR_POLICIES"; exit 0; fi ;;
  "repos pr policy queue "*)
    [ "${STUB_AZURE_POLICY_QUEUE_FAIL:-}" = "1" ] && _stub_fail "TF400898: An internal error occurred." ;;
  "repos pr list "*)
    [ "${STUB_AZURE_PR_LIST_FAIL:-}" = "1" ] && _stub_fail "TF400813: The user is not authorized to access this resource."
    # check-closing-keyword pages (#319): STUB_AZURE_PR_LIST_SKIP_<n> answers
    # the page at --skip <n>; STUB_AZURE_PR_LIST_FULL=1 answers every page
    # with --top active PRs on unrelated branches (a list that never ends).
    _pl_skip="" _pl_top="" _pl_prev=""
    for _a in "$@"; do
      case "$_pl_prev" in --skip) _pl_skip="$_a" ;; --top) _pl_top="$_a" ;; esac
      _pl_prev="$_a"
    done
    _page_var="STUB_AZURE_PR_LIST_SKIP_${_pl_skip:-0}"
    if [ -n "$_pl_skip" ] && [ -n "${!_page_var:-}" ]; then printf '%s\n' "${!_page_var}"; exit 0; fi
    if [ "${STUB_AZURE_PR_LIST_FULL:-}" = "1" ]; then
      python3 -I -c '
import json, sys
skip, top = int(sys.argv[1] or 0), int(sys.argv[2] or 1)
print(json.dumps([{"pullRequestId": 100000 + skip + i, "status": "active",
                   "sourceRefName": "refs/heads/feature/other-%d" % (skip + i)} for i in range(top)]))
' "$_pl_skip" "$_pl_top"
      exit 0
    fi ;;
  "repos pr show "*)
    [ "${STUB_AZURE_PR_SHOW_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    # merge-pr (#709) reads the title with `--query title`: STUB_AZURE_PR_TITLE.
    case "$args" in *"--query title"*) printf '%s\n' "${STUB_AZURE_PR_TITLE:-}"; exit 0 ;; esac
    ;;
  "rest --method get "*"/pullRequests/"*"/labels"*)
    # PR labels (#702): `az repos pr show` never carries labels, so they come
    # from this GET. STUB_AZURE_PR_LABELS is the raw REST body ({"value": [...]});
    # with STUB_AZURE_STATE_DIR set, the label names POSTed so far (one per line
    # in <dir>/labels) are appended.
    [ "${STUB_AZURE_PR_LABELS_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    # STUB_AZURE_PR_LABELS_<id> (#709) answers one PR's labels, else STUB_AZURE_PR_LABELS.
    _lb_id="${args#*pullRequests/}"; _lb_id="${_lb_id%%/*}"
    _lb_var="STUB_AZURE_PR_LABELS_${_lb_id}"
    BASE="${!_lb_var:-${STUB_AZURE_PR_LABELS:-}}" LABELS="${STUB_AZURE_STATE_DIR:-/nonexistent}/labels" python3 -I -c '
import json, os
d = json.loads(os.environ["BASE"] or "{\"value\": []}")
try:
    names = [n for n in open(os.environ["LABELS"]).read().split("\n") if n]
except OSError:
    names = []
d["value"] = d["value"] + [{"id": "x", "name": n, "active": True} for n in names]
print(json.dumps(d, indent=2))  # az rest prints indented JSON
'
    exit 0 ;;
  "rest --method get "*"/pullRequests/"*"/threads"*)
    # Approval verbs (#684): STUB_AZURE_PR_THREADS is the raw REST body
    # ({"value": [threads...]}); with STUB_AZURE_STATE_DIR set, the comments
    # POSTed so far (one request body per line in <dir>/threads) are appended as
    # threads authored by STUB_AZURE_POST_AUTHOR.
    [ "${STUB_AZURE_PR_THREADS_FAIL:-}" = "1" ] && _stub_fail "TF401180: The requested pull request was not found."
    if [ -n "${STUB_AZURE_PR_THREADS:-}${STUB_AZURE_STATE_DIR:-}" ]; then
      BASE="${STUB_AZURE_PR_THREADS:-}" POSTS="${STUB_AZURE_STATE_DIR:-/nonexistent}/threads" \
        AUTHOR="${STUB_AZURE_POST_AUTHOR:-}" python3 -I -c '
import json, os
d = json.loads(os.environ["BASE"] or "{\"value\": []}")
try:
    posts = [json.loads(l) for l in open(os.environ["POSTS"]) if l.strip()]
except OSError:
    posts = []
for i, p in enumerate(posts):
    c = p["comments"][0]
    d["value"].append({"id": 900 + i, "comments": [{"id": 1, "content": c["content"], "commentType": "text",
                       "author": {"displayName": "Poster", "uniqueName": os.environ["AUTHOR"]},
                       "publishedDate": "2026-10-15T00:00:%02dZ" % i}]})
print(json.dumps(d))
'
      exit 0
    fi ;;
  "rest --method post "*"/pullRequests/"*"/threads"*|"rest --method post "*"/pullRequests/"*"/labels"*)
    # STUB_AZURE_POST_FAIL=1 (#705) makes these writes fail.
    [ "${STUB_AZURE_POST_FAIL:-}" = "1" ] && _stub_fail "TF401027: You need the Git 'PullRequestContribute' permission."
    # Approval verbs (#684): with STUB_AZURE_STATE_DIR set, record the write
    # (and log its body) so a later read sees it.
    if [ -n "${STUB_AZURE_STATE_DIR:-}" ]; then
      for _a in "$@"; do
        case "$_a" in
          @*) [ -f "${_a#@}" ] || continue
              if [ -n "${GH_LOG:-}" ]; then { printf 'AZ BODY: '; cat "${_a#@}"; printf '\n'; } >> "$GH_LOG"; fi
              case "$args" in
                *"/threads"*) { cat "${_a#@}"; printf '\n'; } >> "$STUB_AZURE_STATE_DIR/threads" ;;
                *) python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]))["name"])' "${_a#@}" >> "$STUB_AZURE_STATE_DIR/labels" ;;
              esac ;;
        esac
      done
      printf '{}\n'; exit 0
    fi ;;
  "rest --method patch "*"/pullRequests/"*"/threads/"*"/comments/"*)
    # upsert-pr-comment (#709): STUB_AZURE_PATCH_FAIL=1 makes the update fail.
    [ "${STUB_AZURE_PATCH_FAIL:-}" = "1" ] && _stub_fail "TF401027: You need the Git 'PullRequestContribute' permission." ;;
  "rest --method patch "*"/pullRequests/"*)
    # edit-pr-body (#762): log the --body @file (the JSON body) to GH_LOG as
    # `AZ BODY: ...`; STUB_AZURE_PATCH_FAIL=1 makes the update fail.
    [ "${STUB_AZURE_PATCH_FAIL:-}" = "1" ] && _stub_fail "TF401027: You need the Git 'PullRequestContribute' permission."
    for _a in "$@"; do
      case "$_a" in
        @*) [ -f "${_a#@}" ] || continue
            if [ -n "${GH_LOG:-}" ]; then { printf 'AZ BODY: '; cat "${_a#@}"; printf '\n'; } >> "$GH_LOG"; fi ;;
      esac
    done
    printf '{}\n'; exit 0 ;;
  "rest --method delete "*"/pullRequests/"*"/labels/"*)
    # list-needs-owner --clear-answered (#709): STUB_AZURE_LABEL_DELETE_FAIL=1 fails the delete.
    [ "${STUB_AZURE_LABEL_DELETE_FAIL:-}" = "1" ] && _stub_fail "TF401027: You need the Git 'PullRequestContribute' permission." ;;
  "rest --method get "*"/workItems/"*"/comments"*)
    # Attempt verbs (#685): work-item comments. STUB_AZURE_WI_COMMENTS_PAGE_<tok>
    # is the raw REST body ({"comments": [...], "continuationToken": ...}) for
    # the page requested with continuationToken=<tok> (<tok> "first" when the
    # URL carries none), else STUB_AZURE_WI_COMMENTS. With STUB_AZURE_STATE_DIR
    # set, the comments POSTed so far (<dir>/wi_posts, one request body per
    # line) are appended to a page without a continuation token, authored by
    # STUB_AZURE_POST_AUTHOR (uniqueName). STUB_AZURE_WI_FAIL_TOKEN=<tok> fails
    # that page.
    [ "${STUB_AZURE_WI_COMMENTS_FAIL:-}" = "1" ] && _stub_fail "TF401232: Work item does not exist."
    _wi_tok="first"
    case "$args" in *"continuationToken="*) _wi_tok="${args##*continuationToken=}"; _wi_tok="${_wi_tok%%[!A-Za-z0-9._-]*}" ;; esac
    [ "${STUB_AZURE_WI_FAIL_TOKEN:-}" = "$_wi_tok" ] && _stub_fail "VS403403: page unavailable."
    _wi_var="STUB_AZURE_WI_COMMENTS_PAGE_${_wi_tok//[^A-Za-z0-9_]/_}"
    _wi_base="${!_wi_var:-${STUB_AZURE_WI_COMMENTS:-}}"
    if [ -n "$_wi_base${STUB_AZURE_STATE_DIR:-}" ]; then
      BASE="$_wi_base" POSTS="${STUB_AZURE_STATE_DIR:-/nonexistent}/wi_posts" \
        AUTHOR="${STUB_AZURE_POST_AUTHOR:-}" python3 -I -c '
import json, os
d = json.loads(os.environ["BASE"] or "{\"comments\": []}")
if not d.get("continuationToken"):
    try:
        posts = [json.loads(l) for l in open(os.environ["POSTS"]) if l.strip()]
    except OSError:
        posts = []
    for i, p in enumerate(posts):
        d["comments"].append({"id": 900 + i, "text": p["text"],
                              "createdBy": {"displayName": "Poster", "uniqueName": os.environ["AUTHOR"]},
                              "createdDate": "2026-10-15T00:00:%02dZ" % i})
print(json.dumps(d))
'
      exit 0
    fi ;;
  "rest --method post "*"/workItems/"*"/comments"*)
    # STUB_AZURE_WI_POST_FAIL=1 (#765) makes the work-item comment write fail.
    [ "${STUB_AZURE_WI_POST_FAIL:-}" = "1" ] && _stub_fail "TF401027: You need the Work Item 'Edit' permission."
    # Attempt verbs (#685): with STUB_AZURE_STATE_DIR set, record the write.
    if [ -n "${STUB_AZURE_STATE_DIR:-}" ]; then
      for _a in "$@"; do
        case "$_a" in
          @*) [ -f "${_a#@}" ] || continue
              if [ -n "${GH_LOG:-}" ]; then { printf 'AZ BODY: '; cat "${_a#@}"; printf '\n'; } >> "$GH_LOG"; fi
              { cat "${_a#@}"; printf '\n'; } >> "$STUB_AZURE_STATE_DIR/wi_posts" ;;
        esac
      done
      printf '{}\n'; exit 0
    fi ;;
  "rest --method get "*"/_apis/projects/"*"/teams?"*)
    # Board column resolution (#732): the project's teams. STUB_AZURE_TEAMS is
    # the raw REST body ({"value": [{"id","name"}...]}).
    [ "${STUB_AZURE_TEAMS_FAIL:-}" = "1" ] && _stub_fail "VS403403: no access to the teams."
    if [ -n "${STUB_AZURE_TEAMS:-}" ]; then printf '%s\n' "$STUB_AZURE_TEAMS"; exit 0; fi ;;
  "rest --method get "*"/teamsettings/teamfieldvalues"*)
    # A team's default area path: STUB_AZURE_TEAMFIELDS_<team id> answers one
    # team (the raw {"defaultValue": ...} body), else STUB_AZURE_TEAMFIELDS.
    [ "${STUB_AZURE_TEAMFIELDS_FAIL:-}" = "1" ] && _stub_fail "VS403403: no access to the team settings."
    _tf_id="${args%%/_apis/work/teamsettings*}"; _tf_id="${_tf_id##*/}"
    _tf_var="STUB_AZURE_TEAMFIELDS_${_tf_id//[^A-Za-z0-9_]/_}"
    if [ -n "${!_tf_var:-}" ]; then printf '%s\n' "${!_tf_var}"; exit 0; fi
    if [ -n "${STUB_AZURE_TEAMFIELDS:-}" ]; then printf '%s\n' "$STUB_AZURE_TEAMFIELDS"; exit 0; fi ;;
  "rest --method get "*"/_apis/projects/"*"?"*)
    # The project (#743): STUB_AZURE_PROJECT is the raw body, whose
    # defaultTeam.id names the team the board calls fall back to.
    [ "${STUB_AZURE_PROJECT_FAIL:-}" = "1" ] && _stub_fail "VS403403: no access to the project."
    if [ -n "${STUB_AZURE_PROJECT:-}" ]; then printf '%s\n' "$STUB_AZURE_PROJECT"; exit 0; fi ;;
  "rest --method get "*"/_apis/work/backlogs"*)
    # STUB_AZURE_BACKLOGS is the raw body ({"value": [{"name","type"}...]}).
    [ "${STUB_AZURE_BACKLOGS_FAIL:-}" = "1" ] && _stub_fail "VS403403: no access to the backlogs."
    # The live service answers 404 without a team (#743): <host>/<org>/<project>
    # is the team-less shape, <host>/<org>/<project>/<team> carries one.
    _bl_url="${args%%/_apis/work/backlogs*}"; _bl_url="${_bl_url##* }"; _bl_url="${_bl_url#*://}"
    _bl_slashes="${_bl_url//[^\/]/}"
    [ "${#_bl_slashes}" -le 2 ] && _stub_fail "404: Page not found (no team in the backlogs URL)."
    if [ -n "${STUB_AZURE_BACKLOGS:-}" ]; then printf '%s\n' "$STUB_AZURE_BACKLOGS"; exit 0; fi ;;
  "rest --method get "*"/_apis/work/boards/"*"/columns"*)
    # STUB_AZURE_BOARD_COLUMNS is the raw body ({"value": [{"name","stateMappings"}...]}).
    [ "${STUB_AZURE_BOARD_COLUMNS_FAIL:-}" = "1" ] && _stub_fail "VS403403: no access to the board."
    if [ -n "${STUB_AZURE_BOARD_COLUMNS:-}" ]; then printf '%s\n' "$STUB_AZURE_BOARD_COLUMNS"; exit 0; fi ;;
  "boards work-item show "*"System.BoardColumn"*)
    # The column read-back after a state move: STUB_AZURE_BOARDCOLUMN, empty
    # when unset; STUB_AZURE_BOARDCOLUMN_FAIL=1 fails the read.
    [ "${STUB_AZURE_BOARDCOLUMN_FAIL:-}" = "1" ] && _stub_fail "TF401232: Work item does not exist."
    printf '%s\n' "${STUB_AZURE_BOARDCOLUMN:-}"; exit 0 ;;
  "boards work-item show "*"-o tsv") ;;
  "boards work-item show "*"--expand relations"*)
    [ "${STUB_AZURE_WORKITEM_RELATIONS_FAIL:-}" = "1" ] && _stub_fail "TF401232: Work item does not exist." ;;
  "boards work-item show "*)
    # check-epic-acceptance: STUB_AZURE_WORKITEM_JSON is the raw response;
    # STUB_AZURE_WORKITEM_DESCRIPTION(_FILE) sets fields.System.Description.
    [ "${STUB_AZURE_WORKITEM_SHOW_FAIL:-}" = "1" ] && _stub_fail "TF401232: Work item does not exist."
    if [ -n "${STUB_AZURE_WORKITEM_JSON:-}" ]; then printf '%s\n' "$STUB_AZURE_WORKITEM_JSON"; exit 0; fi
    if [ -n "${STUB_AZURE_WORKITEM_DESCRIPTION:-}${STUB_AZURE_WORKITEM_DESCRIPTION_FILE:-}" ]; then
      python3 -I -c "
import json, os
f = os.environ.get('STUB_AZURE_WORKITEM_DESCRIPTION_FILE')
desc = open(f).read() if f else os.environ['STUB_AZURE_WORKITEM_DESCRIPTION']
print(json.dumps({'id': 42, 'fields': {'System.Title': 'Epic', 'System.Description': desc}}))
"
      exit 0
    fi ;;
esac

case "$args" in
  "extension list "*)
    # Return a line containing azure-devops so the extension check passes
    printf 'azure-devops\t1.0.0\t/path/to/ext\n' ;;
  "boards work-item show "*"-o tsv")
    # Canned current tags for label-issue test. STUB_AZURE_WORKITEM_TAGS
    # overrides (#298: close-issue strips pipeline:* tags).
    printf '%s\n' "${STUB_AZURE_WORKITEM_TAGS:-bug; ui}" ;;
  "boards work-item show "*"--expand relations"*)
    # find-pr (#298) reads the work item's ArtifactLink relations to find
    # linked PRs. STUB_AZURE_WORKITEM_RELATIONS is the raw relations array.
    printf '{"id":5,"relations":%s}\n' "${STUB_AZURE_WORKITEM_RELATIONS:-[]}" ;;
  "boards work-item show "*)
    # System.AssignedTo reflects STUB_ASSIGNEE_FILE (#299; absent or empty =
    # unassigned, i.e. the field is missing, as ADO returns it), so
    # assign-issue's write is visible to its read-back.
    _as_cur=""
    _as_f="$(_as_path "$(_as_id "$@")")"
    [ -n "$_as_f" ] && [ -s "$_as_f" ] && _as_cur="$(cat "$_as_f")"
    CUR="$_as_cur" python3 -I -c "
import json, os
cur = os.environ['CUR']
fields = {'System.Title': 'Fix login crash', 'System.Tags': 'bug; ui'}
if cur:
    fields['System.AssignedTo'] = {'displayName': cur, 'uniqueName': cur}
print(json.dumps({'id': 5, 'fields': fields}))
" ;;
  "boards query "*)
    # Canned WIQL result set for list-issues.
    # Override STUB_AZURE_WORKITEM_LIST to simulate a capped/large result set (#171),
    # or STUB_AZURE_WORKITEM_LIST_FILE (a path) when the fixture is too big for
    # the environment (#278: the 20000-item ceiling fixture exceeds ARG_MAX).
    if [ -n "${STUB_AZURE_WORKITEM_LIST_FILE:-}" ]; then
      cat "$STUB_AZURE_WORKITEM_LIST_FILE"
    elif [ -n "${STUB_AZURE_WORKITEM_LIST:-}" ]; then
      printf '%s\n' "$STUB_AZURE_WORKITEM_LIST"
    else
      printf '[{"id":5,"fields":{"System.Title":"Fix login crash","System.State":"New","System.Tags":"pipeline:ready"}}]\n'
    fi ;;
  "boards work-item create "*)
    printf '{"id":1}\n' ;;
  "boards work-item update "*"--assigned-to "*)
    # assign-issue's write (#299). STUB_ASSIGN_FAIL / STUB_ASSIGN_DROP as in
    # the gh stub.
    if [ "${STUB_ASSIGN_FAIL:-}" = "1" ]; then
      echo "ERROR: TF401320: Rule Error for field Assigned To. Error code: Required, HasValues, LimitedToValues, AllowsOldValue, InvalidEmpty." >&2
      exit 1
    fi
    _as_prev=""
    for _as_a in "$@"; do
      [ "$_as_prev" = "--assigned-to" ] && _as_login="$_as_a"
      _as_prev="$_as_a"
    done
    # An empty --assigned-to clears the field (unassign-issue, #560).
    # STUB_ASSIGNEE_RACER=<login> (#560): another operator's write lands right
    # after this one and, ADO having one assignee, replaces it.
    _as_f="$(_as_path "$(_as_id "$@")")"
    if [ "${STUB_ASSIGN_DROP:-}" != "1" ] && [ -n "$_as_f" ]; then
      printf '%s\n' "$_as_login" | sed '/^$/d' > "$_as_f"
      [ -n "${STUB_ASSIGNEE_RACER:-}" ] && [ -n "$_as_login" ] && printf '%s\n' "$STUB_ASSIGNEE_RACER" > "$_as_f"
    fi
    exit 0 ;;
  "boards work-item update "*"-o none"|"boards work-item update "*"--output none")
    exit 0 ;;  # -o none / --output none print nothing, as the real az does
  "boards work-item update "*)
    printf '{"id":1}\n' ;;
  "account get-access-token "*)
    # attach-files on azure (#776) uploads with curl and an Azure DevOps token.
    [ "${STUB_AZURE_TOKEN_FAIL:-}" = "1" ] && _stub_fail "Please run 'az login' to setup account."
    printf 'stub-ado-token\n' ;;
  "account show "*)
    # Operator identity for issues.assignee: self (#299).
    printf '%s\n' "${STUB_CURRENT_USER:-}" ;;
  "repos pr update "*)
    printf '{"pullRequestId":7,"status":"completed"}\n' ;;
  "repos pr create "*)
    printf '{"pullRequestId":7,"status":"active"}\n' ;;
  "repos pr list "*)
    # Override STUB_AZURE_PR_LIST to simulate a capped/large result set (#171).
    if [ -n "${STUB_AZURE_PR_LIST:-}" ]; then
      printf '%s\n' "$STUB_AZURE_PR_LIST"
    else
      printf '[{"pullRequestId":7,"title":"fix: guard","status":"active","sourceRefName":"refs/heads/fix/issue-42-guard"}]\n'
    fi ;;
  "repos pr show "*)
    # diff-pr / checkout-pr query specific refs with -o tsv; honor that.
    case "$args" in
      *sourceRefName*tsv*)
        # STUB_AZURE_PR_SOURCE overrides the source branch (#766); set to ""
        # it prints nothing, as for a PR whose source cannot be resolved.
        if [ "${STUB_AZURE_PR_SOURCE+set}" = "set" ]; then
          [ -n "$STUB_AZURE_PR_SOURCE" ] && printf 'refs/heads/%s\n' "$STUB_AZURE_PR_SOURCE"
        else
          printf 'refs/heads/fix/issue-5-x\n'
        fi ;;
      *targetRefName*tsv*) printf 'refs/heads/main\n' ;;
      *)
        # find-pr (#298): STUB_AZURE_PR_<id> overrides the PR object per id.
        _prs_id=""; _prs_prev=""
        for _a in "$@"; do [ "$_prs_prev" = "--id" ] && _prs_id="$_a"; _prs_prev="$_a"; done
        _prs_var="STUB_AZURE_PR_${_prs_id}"
        if [ -n "$_prs_id" ] && [ -n "${!_prs_var:-}" ]; then
          printf '%s\n' "${!_prs_var}"
        else
          printf '{"pullRequestId":7,"status":"active"}\n'
        fi ;;
    esac ;;
  "boards work-item comment add "*)
    printf '{"id":1,"text":"stub comment"}\n' ;;
  "rest "*"workitemtypes"*)
    # bootstrap-board.sh (#266) Azure state validation: GET
    # .../_apis/wit/workitemtypes/<type>?api-version=... -- lists the work
    # item type's allowed states. Override STUB_AZURE_STATES_JSON (raw
    # {"states":[...]} body) to simulate a missing state. Must come BEFORE
    # the generic "rest "* case below (bash `case` matches first).
    if [ -n "${STUB_AZURE_STATES_JSON:-}" ]; then
      printf '%s\n' "$STUB_AZURE_STATES_JSON"
    else
      printf '{"states":[{"name":"New"},{"name":"Committed"},{"name":"Done"}]}\n'
    fi ;;
  "rest "*)
    # label-issue uses `az rest` for the json-patch tag update. Echo the
    # --body @file contents into the log so tests can assert the computed tags.
    if [ -n "${GH_LOG:-}" ]; then
      for _a in "$@"; do
        case "$_a" in
          @*) [ -f "${_a#@}" ] && { printf 'AZ BODY: '; cat "${_a#@}"; printf '\n'; } >> "$GH_LOG" ;;
        esac
      done
    fi
    printf '{"id":5,"fields":{"System.Tags":"stub"}}\n' ;;
  *)
    printf '{}\n' ;;
esac
exit 0
